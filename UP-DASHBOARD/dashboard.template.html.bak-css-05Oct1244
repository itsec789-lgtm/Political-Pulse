<script>
const AGG="__MONGO_AGG__";
try{window.__DATES__=(AGG&&AGG.dates&&AGG.dates.length)?AGG.dates:[];}catch(e){window.__DATES__=[];}
const PHD="__MONGO_PHD__";
const GROWTH="__MONGO_GROWTH__";
(function(){
 var PC={'BJP':'#FF7A00','INC':'#19AAED','AAP':'#1f9bd6','TMC':'#0D47A1','DMK':'#E5161D','SP':'#C62828','BRS':'#E91E63','YSRCP':'#1565C0','TDP':'#FFB300','TDP':'#FFB300','JD(U)':'#2E7D32','JMM':'#2E7D32','NDPP':'#7B1FA2','NPP':'#00897B','SKM':'#5D4037','ZPM':'#6D4C41','JKNC':'#E53935','CPI(M)':'#D32F2F','TVK':'#FFC107','BJD':'#1565C0','RJD':'#43A047'};
 function pc2(p){return PC[p]||'#9aa0a6';}
 function esc2(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
 function uf2(n){n=Math.round(n||0);if(n>=1e7)return(n/1e7).toFixed(2)+'Cr';if(n>=1e5)return(n/1e5).toFixed(2)+'L';if(n>=1e3)return(n/1e3).toFixed(1)+'K';return ''+n;}
 function shp(p){var m=String(p||'').match(/\(([^)]+)\)\s*$/);return (m&&p.length>10)?m[1]:p;}
 var GUP='#16A34A',GDN='#DC2626';
 var H=GROWTH.H, AD=AGG.dates, AS=AGG.S, ch={};
 function lvVal(){return (document.getElementById('gLevel')||{}).value||'ALL';}
 function ptVal(){return (document.getElementById('gParty')||{}).value||'ALL';}
 function repopulateParties(){
   var lv=lvVal();var sel=document.getElementById('gParty');if(!sel)return;var cur=sel.value;
   var set={};Object.keys(AS).forEach(function(key){var pr=key.split('|');if(pr[1]==='ALL')return;if(lv==='ALL'){if(key.indexOf('ALL|')===0)set[pr.slice(1).join('|')]=1;}else{if(pr[0]===lv)set[pr.slice(1).join('|')]=1;}});
   var ps=Object.keys(set).sort();
   sel.innerHTML='<option value="ALL">All Parties</option>'+ps.map(function(p){return '<option value="'+esc2(p)+'">'+esc2(shp(p))+'</option>';}).join('');
   sel.value=(cur&&(cur==='ALL'||set[cur]))?cur:'ALL';
 }
 function initGrowth(){
   var f=document.getElementById('gFrom'),t=document.getElementById('gTo');
   if(f){if(!f.value)f.value=AD[0];f.min=AD[0];f.max=AD[AD.length-1];}
   if(t){if(!t.value)t.value=AD[AD.length-1];t.min=AD[0];t.max=AD[AD.length-1];}
   var sel=document.getElementById('gParty');if(sel&&sel.dataset.ready!=='1'){repopulateParties();sel.dataset.ready='1';}
 }
 function dateIdx(){var f=(document.getElementById('gFrom')||{}).value||AD[0];var t=(document.getElementById('gTo')||{}).value||AD[AD.length-1];var idx=[];AD.forEach(function(d,i){if(d>=f&&d<=t)idx.push(i);});return idx.length?idx:AD.map(function(d,i){return i;});}
 function curKey(){return lvVal()+'|'+ptVal();}
 function daily(metric,idx){var o=AS[curKey()];if(!o)return idx.map(function(){return 0;});return idx.map(function(i){return o[metric][i]||0;});}
 function selHandles(){var lv=lvVal(),pt=ptVal();return Object.keys(H).filter(function(h){var o=H[h];return (lv==='ALL'||o.l===lv)&&(pt==='ALL'||o.p===pt);});}
 function mkTrend(id,labels,data,base){var el=document.getElementById(id);if(!el)return;if(ch[id])ch[id].destroy();
   var pcol=data.map(function(v,i){return i===0?base:(v>=data[i-1]?GUP:GDN);});
   ch[id]=new Chart(el,{type:'line',data:{labels:labels,datasets:[{data:data,borderColor:base,backgroundColor:base+'18',fill:true,tension:.25,borderWidth:2,pointRadius:data.length>20?2:3,pointBackgroundColor:pcol,pointBorderColor:pcol,
     segment:{borderColor:function(ctx){return ctx.p1.parsed.y>=ctx.p0.parsed.y?GUP:GDN;}}}]},
     options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},datalabels:{display:false},tooltip:{callbacks:{label:function(c){return uf2(c.parsed.y);}}}},
     scales:{x:{ticks:{color:'#888',font:{size:8},maxRotation:0,autoSkip:true,maxTicksLimit:8},grid:{display:false}},y:{ticks:{color:'#888',font:{size:9},callback:function(v){return uf2(v);}},grid:{color:'#ece9e0'}}}}});}
 function kpi(val,lbl,col){return '<div style="flex:1;min-width:110px;background:var(--card);border:1.5px solid var(--border);border-left:4px solid '+col+';border-radius:12px;padding:13px 15px"><div style="font-family:Rajdhani,sans-serif;font-weight:700;font-size:22px;color:'+col+';line-height:1">'+val+'</div><div style="font-size:11px;color:var(--muted);margin-top:3px">'+lbl+'</div></div>';}
 function renderPeople(){
   var hs=selHandles().slice().sort(function(a,b){return (H[b].f[H[b].f.length-1]||0)-(H[a].f[H[a].f.length-1]||0);});
   var box=document.getElementById('gPeople');if(!box)return;var li=GROWTH.dates.length-1;
   if(!hs.length){box.innerHTML='<div style="color:var(--muted);font-size:12px;padding:16px">No handles match.</div>';return;}
   box.innerHTML=hs.slice(0,400).map(function(h){var o=H[h];var c=pc2(o.p);
     return '<div onclick="gShowPerson(\''+h+'\')" style="display:flex;align-items:center;gap:10px;padding:8px 10px;border-bottom:1px solid var(--border);cursor:pointer" onmouseover="this.style.background=\'rgba(230,81,0,.06)\'" onmouseout="this.style.background=\'\'">'+
     '<div style="flex:1;min-width:0"><div style="font-weight:700;font-size:13px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">'+esc2(o.n||h)+'</div><div style="font-size:10px;color:var(--muted)">@'+esc2(h)+' · <span style="'+((window.isCurrent&&window.isCurrent(h))?'color:#177245;font-weight:700':'color:#C9A227;font-weight:700')+'">'+esc2(window.roleOf?window.roleOf(h,o.l):o.l)+'</span></div></div>'+
     '<span class="party-chip" style="background:'+c+'18;color:'+c+';flex:none">'+esc2(shp(o.p))+'</span>'+
     '<div style="text-align:right;min-width:58px;flex:none"><div style="font-family:Rajdhani;font-weight:700;font-size:13px;color:var(--text)">'+uf2(o.f[li]||0)+'</div><div style="font-size:9px;color:var(--muted2)">followers</div></div></div>';
   }).join('');
 }
 window.gShowPerson=function(h){
   var o=H[h];if(!o)return;var p=document.getElementById('gPersonPanel');if(!p)return;var c=pc2(o.p);var li=GROWTH.dates.length-1;
   var tw=o.t[li]||0,vw=o.v[li]||0,lk=o.k[li]||0,rt=o.r[li]||0,avgV=tw?Math.round(vw/tw):0,avgL=tw?Math.round(lk/tw):0;
