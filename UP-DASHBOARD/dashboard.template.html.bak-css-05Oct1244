<script>
/* Chart.js ke legend chart config me 'right' set hain -- phone par wo aadhi
 * chaudai kha jaate hain. Chart banne se PEHLE hi bottom kar dete hain. */
(function(){
  if(!window.Chart) return;
  if(!window.matchMedia('(max-width:820px)').matches) return;
  Chart.register({
    id:'mobileLegend',
    beforeInit:function(c){
      try{
        var L = c.options && c.options.plugins && c.options.plugins.legend;
        if(L && L.display !== false && (L.position==='right'||L.position==='left')){
          L.position='bottom';
          L.labels = L.labels || {};
          L.labels.boxWidth = 9; L.labels.padding = 6;
          L.labels.font = Object.assign({}, L.labels.font||{}, {size:9});
        }
        var sc = c.options && c.options.scales;
        if(sc) Object.keys(sc).forEach(function(k){
          if(sc[k] && sc[k].ticks) sc[k].ticks.font = Object.assign({}, sc[k].ticks.font||{}, {size:8});
        });
      }catch(e){}
    }
  });
})();

/* Sidebar mobile par: pin hatao, hamburger do, parda lagao, tab dabate hi band.
 * BAHUT ZAROORI: resize par drawer band NAHI karte. Android me scroll karte hi
 * address bar chhupti hai aur resize fire hota hai -- pehle isi se drawer
 * khulte hi band ho jaata tha. */
(function(){
  function MOB(){ return window.matchMedia('(max-width:820px)').matches; }
  var sb=null, bd=null, burger=null, cleaned=false;

  function close(){ if(sb){ sb.classList.remove('show'); document.body.classList.remove('sb-open'); } }
  function open(){  if(sb){ sb.classList.add('show');    document.body.classList.add('sb-open'); } }
  function toggle(){ if(sb) sb.classList.contains('show') ? close() : open(); }

  function build(){
    sb = document.querySelector('.sidebar');
    if(!sb) return false;

    if(MOB()){
      // pin HAR BAAR hatao -- page ka apna script localStorage se dobara laga sakta hai.
      // (ye idempotent hai, isse drawer band nahi hota)
      document.body.classList.remove('sb-pinned');
      // .show sirf PEHLI baar hatao -- warna khula drawer apne aap band ho jaayega
      if(!cleaned){ cleaned = true; sb.classList.remove('show'); }
    }
    if(!bd){
      bd = document.createElement('div');
      bd.className = 'sb-backdrop'; bd.id = 'sbBackdrop';
      bd.addEventListener('click', close);
      document.body.appendChild(bd);
    }
    if(!burger){
      var hd = document.querySelector('header');
      if(hd){
        burger = document.createElement('button');
        burger.className = 'mob-burger'; burger.type = 'button';
        burger.setAttribute('aria-label','Menu');
        burger.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" '
          + 'stroke="currentColor" stroke-width="2.5" stroke-linecap="round">'
          + '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/>'
          + '<line x1="3" y1="18" x2="21" y2="18"/></svg>';
        burger.addEventListener('click', function(ev){
          ev.preventDefault(); ev.stopPropagation(); toggle();
        });
        hd.insertBefore(burger, hd.firstChild);
      }
    }
    return true;
  }

  function wire(){
    if(!build()) return;
    if(sb.__mobWired) return;
    sb.__mobWired = true;

    // menu chunte hi drawer band (warna section peeche khulta hai aur dikhta nahi)
    sb.addEventListener('click', function(e){
      var t = (e.target && e.target.closest) ? e.target.closest('.mnav-tab') : null;
      if(t && MOB()) setTimeout(close, 150);
    });
    // page ka apna script .show lagata/hataata hai -> body ka flag saath rakho
    try{
      new MutationObserver(function(){
        document.body.classList.toggle('sb-open', sb.classList.contains('show'));
      }).observe(sb, {attributes:true, attributeFilter:['class']});
    }catch(e){}
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape') close(); });
  }

  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', wire);
  else wire();
  window.addEventListener('load', function(){ wire(); setTimeout(wire, 400); });
})();
</script>
