      [['Positive',_ss.pos,'#2E7D32'],['Neutral',_ss.neu,'#FF8F00'],['Negative',_ss.neg,'#C62828']].forEach(function(x){h+='<td style="padding:10px;border:1px solid #f0e6d8"><div style="font-size:18px;font-weight:800;color:'+x[2]+'">'+IN(x[1])+'</div><div style="font-size:10px;color:#888;text-transform:uppercase">'+x[0]+' ('+Math.round(x[1]*100/_st)+'%)</div></td>';});
      h+='</tr></table>';}
    if(rep.daily&&rep.daily.length){var _dd=rep.daily.slice(-14);var _mx=1;_dd.forEach(function(x){if(x.c>_mx)_mx=x.c;});
      h+=band('Topic Trend (Daily)'+((rep.momentum!==null&&rep.momentum!==undefined)?(' &mdash; '+(rep.momentum>0?'+':'')+rep.momentum+'% momentum'):''));
      h+='<table style="width:100%;border-collapse:collapse;font-family:sans-serif;font-size:11px">';
