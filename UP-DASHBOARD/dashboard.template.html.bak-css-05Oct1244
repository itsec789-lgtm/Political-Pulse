  }
}

function buildMap(){
  const grp=document.getElementById('statesGroup');
  grp.innerHTML='';
  document.getElementById('stateLabels').innerHTML='';
  const stateCoords={};const CEN={};
  let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
  GEOJSON.features.forEach(feat=>{
    const dn=g2d(feat.properties.NAME_1);
    if(!stateCoords[dn]) stateCoords[dn]=[];
    const geom=feat.geometry;
    const polys=geom.type==='MultiPolygon'?geom.coordinates:[geom.coordinates];
    stateCoords[dn].push(...polys);
    polys.forEach(poly=>poly.forEach(ring=>ring.forEach(pt=>{
      const x=pt[0],y=42-(pt[1]-6);
      if(x<minX)minX=x;if(x>maxX)maxX=x;if(y<minY)minY=y;if(y>maxY)maxY=y;
    })));
  });
  const pad=0.3;const lpad=6.5,rpad=1.0;
  document.getElementById('indiaMap').setAttribute('viewBox',`${(minX-lpad).toFixed(2)} ${(minY-pad).toFixed(2)} ${(maxX-minX+lpad+rpad).toFixed(2)} ${(maxY-minY+pad*2).toFixed(2)}`);
  Object.entries(stateCoords).forEach(([dn,polys])=>{
    let d='';
    polys.forEach(poly=>{
      poly.forEach(ring=>{
        if(!ring||ring.length<3)return;
        const pts=ring.map(pt=>`${pt[0].toFixed(4)},${(42-(pt[1]-6)).toFixed(4)}`);
        d+=`M${pts.join('L')}Z`;
      });
    });
    if(!d)return;
    const path=document.createElementNS('http://www.w3.org/2000/svg','path');
    path.setAttribute('d',d);
    path.setAttribute('class','state-path');
    path.setAttribute('data-state',dn);
    path.style.fill=getStateColor(dn);
    path.addEventListener('mousemove',e=>showTT(e,dn));
    path.addEventListener('mouseleave',hideTT);
    path.addEventListener('click',()=>selectState(dn));
    grp.appendChild(path);

    const labelsGroup = document.getElementById('stateLabels');
    let bestPoly=null,bestA=-1;
    polys.forEach(function(poly){var ring=poly[0];if(!ring||ring.length<3)return;var x0=1e9,x1=-1e9,y0=1e9,y1=-1e9;ring.forEach(function(pt){var x=pt[0],y=42-(pt[1]-6);if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;});var a=(x1-x0)*(y1-y0);if(a>bestA){bestA=a;bestPoly=poly;}});
    if(bestPoly){
      var oring=bestPoly[0];var A=0,Cx=0,Cy=0;
      for(var k=0;k<oring.length-1;k++){var ax=oring[k][0],ay=42-(oring[k][1]-6),bx2=oring[k+1][0],by2=42-(oring[k+1][1]-6);var cr=ax*by2-bx2*ay;A+=cr;Cx+=(ax+bx2)*cr;Cy+=(ay+by2)*cr;}
      var cx,cy;
      if(Math.abs(A)>1e-9){A*=0.5;cx=Cx/(6*A);cy=Cy/(6*A);}else{var bx0=1e9,bx1=-1e9,by0=1e9,by1=-1e9;oring.forEach(function(pt){var x=pt[0],y=42-(pt[1]-6);if(x<bx0)bx0=x;if(x>bx1)bx1=x;if(y<by0)by0=y;if(y>by1)by1=y;});cx=(bx0+bx1)/2;cy=(by0+by1)/2;}
      CEN[dn]=[cx,cy];
      const text=document.createElementNS('http://www.w3.org/2000/svg','text');
      text.setAttribute('x',cx);
      text.setAttribute('y',cy);
      text.setAttribute('class','state-label');
      text.setAttribute('data-state',dn);
      text.setAttribute('pointer-events','none');
      const shortNames={'Andaman and Nicobar':'A&N','Andhra Pradesh':'AP','Arunachal Pradesh':'AR','Assam':'AS',
        'Bihar':'BR','Chandigarh':'CH','Chhattisgarh':'CG','Dadra and Nagar Haveli':'DNH',
        'Daman and Diu':'DD','Goa':'GA','Gujarat':'GJ','Haryana':'HR','Himachal Pradesh':'HP',
        'Jammu & Kashmir':'J&K','Jammu and Kashmir':'J&K','Jharkhand':'JH','Karnataka':'KA','Kerala':'KL',
        'Lakshadweep':'LD','Madhya Pradesh':'MP','Maharashtra':'MH','Manipur':'MN',
        'Meghalaya':'ML','Mizoram':'MZ','Nagaland':'NL','NCT of Delhi':'DL','Delhi (NCT)':'DL',
        'Odisha':'OD','Puducherry':'PY','Punjab':'PB','Rajasthan':'RJ','Sikkim':'SK',
        'Tamil Nadu':'TN','Telangana':'TS','Tripura':'TR','Uttar Pradesh':'UP',
        'Uttarakhand':'UK','West Bengal':'WB'};
      text.textContent = shortNames[dn] || dn.slice(0,3).toUpperCase();
      labelsGroup.appendChild(text);
    }
  });
  drawCallouts(grp,CEN,stateCoords);
  renderLegend();
}
function drawCallouts(grp,CEN,SC){
  const NS='http://www.w3.org/2000/svg';
  const BS=3.3;
  const list=[
    {dn:'Chandigarh',lx:65.0,ly:13.0,txt:'Chandigarh'},
    {dn:'Delhi',lx:65.0,ly:20.0,txt:'Delhi'},
    {dn:'Goa',lx:65.0,ly:30.0,txt:'Goa'},
    {dn:'Puducherry',lx:86.5,ly:33.5,txt:'Puducherry'}
  ];
  function miniPath(polys,bx,by){
    var best=null,bestA=-1;
    polys.forEach(function(poly){var x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;poly.forEach(function(ring){ring.forEach(function(pt){var x=pt[0],y=42-(pt[1]-6);if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;})});var a=(x1-x0)*(y1-y0);if(a>bestA){bestA=a;best=poly;}});
    if(!best)return '';
    var x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;best.forEach(function(ring){ring.forEach(function(pt){var x=pt[0],y=42-(pt[1]-6);if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;})});
    var w=(x1-x0)||0.001,h=(y1-y0)||0.001,sc=BS/Math.max(w,h);var ox=bx-(x0+w/2)*sc,oy=by-(y0+h/2)*sc;var dd='';
    best.forEach(function(ring){if(!ring||ring.length<3)return;var pts=ring.map(function(pt){return (pt[0]*sc+ox).toFixed(3)+','+((42-(pt[1]-6))*sc+oy).toFixed(3)});dd+='M'+pts.join('L')+'Z';});
    return dd;
  }
  list.forEach(o=>{
    const c=CEN[o.dn],polys=SC[o.dn];if(!c||!polys)return;
    const col=getStateColor(o.dn);
    const g=document.createElementNS(NS,'g');g.style.cursor='pointer';g.setAttribute('class','map-callout');g.setAttribute('data-cstate',o.dn);
    const ln=document.createElementNS(NS,'line');
    ln.setAttribute('x1',c[0]);ln.setAttribute('y1',c[1]);ln.setAttribute('x2',o.lx);ln.setAttribute('y2',o.ly);
    ln.setAttribute('stroke','#1a1a1a');ln.setAttribute('stroke-width','0.13');ln.setAttribute('stroke-linecap','round');
    g.appendChild(ln);
    const mk=document.createElementNS(NS,'circle');
    mk.setAttribute('cx',c[0]);mk.setAttribute('cy',c[1]);mk.setAttribute('r','0.6');
    mk.setAttribute('fill',col);mk.setAttribute('stroke','#fff');mk.setAttribute('stroke-width','0.18');mk.setAttribute('class','cc-col');
    g.appendChild(mk);
    const mp=document.createElementNS(NS,'path');
    mp.setAttribute('d',miniPath(polys,o.lx,o.ly));
    mp.setAttribute('fill',col);mp.setAttribute('stroke','#fff');mp.setAttribute('stroke-width','0.14');mp.setAttribute('stroke-linejoin','round');mp.setAttribute('class','cc-col');
    g.appendChild(mp);
    const t=document.createElementNS(NS,'text');
    t.setAttribute('x',o.lx);t.setAttribute('y',o.ly+BS/2+1.1);t.setAttribute('text-anchor','middle');t.setAttribute('dominant-baseline','middle');
    t.setAttribute('fill',col);t.setAttribute('class','cc-col');t.setAttribute('font-size','0.95');t.setAttribute('font-weight','700');t.setAttribute('font-family',"'DM Sans',sans-serif");
    t.textContent=o.txt;g.appendChild(t);
    g.addEventListener('mousemove',e=>showTT(e,o.dn));
    g.addEventListener('mouseleave',hideTT);
    g.addEventListener('click',()=>selectState(o.dn));
    grp.appendChild(g);
  });
}
function renderColors(){document.querySelectorAll('.state-path').forEach(p=>p.style.fill=getStateColor(p.getAttribute('data-state')));document.querySelectorAll('.map-callout').forEach(g=>{const s=g.getAttribute('data-cstate');if(!s)return;const col=getStateColor(s);g.querySelectorAll('.cc-col').forEach(el=>el.setAttribute('fill',col));})}
function setMapMode(m){mapMode=m;document.querySelectorAll('.mode-btn').forEach(b=>b.classList.toggle('active',b.textContent.toLowerCase()===m));renderColors();renderLegend()}
function filterParty(p,btn){partyFilter=p;document.querySelectorAll('.filter-pill').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(selectedState)showStatePanel(selectedState);else renderDefaultPanel()}
function showTT(e,s){
  const tt=document.getElementById('mapTooltip');
  const sd=getSD(s);const cm=getCMs(s).find(c=>c.level==='Chief Minister');
  let h=`<div class="tt-state">${s}</div>`;
  if(cm)h+=`<div class="tt-cm">${cm.name} · ${cm.party}</div>`;
  if(sd){h+=`<div class="tt-row"><span class="tt-lbl">Tweets</span><span class="tt-val">${sd.tweets}</span></div><div class="tt-row"><span class="tt-lbl">Views</span><span class="tt-val">${fmt(sd.views)}</span></div><div class="tt-row"><span class="tt-lbl">Positive</span><span class="tt-val" style="color:#66BB6A">${sd.pos}</span></div><div class="tt-row"><span class="tt-lbl">Negative</span><span class="tt-val" style="color:#EF5350">${sd.neg}</span></div>`}
  else h+=`<div style="font-size:10px;color:rgba(255,255,255,.4);margin-top:4px">No CM/DCM data</div>`;
  h+=`<div class="tt-hint">Click for full details &rarr;</div>`;
  tt.innerHTML=h;tt.style.display='block';
  tt.style.left=(e.clientX+16)+'px';tt.style.top=(e.clientY-8)+'px';
  const r=tt.getBoundingClientRect();
  if(r.right>window.innerWidth-10)tt.style.left=(e.clientX-r.width-12)+'px';
  if(r.bottom>window.innerHeight-10)tt.style.top=(e.clientY-r.height-8)+'px';
}
function hideTT(){document.getElementById('mapTooltip').style.display='none'}
function selectState(s){
  document.querySelectorAll('.state-path').forEach(p=>p.classList.remove('selected'));
  if(selectedState===s){selectedState=null;renderDefaultPanel();restoreMainTable();var _s0=document.getElementById('stateSel');if(_s0)_s0.value='';return}
  selectedState=s;
  const p=document.querySelector('[data-state="'+s.replace(/"/g,'\\"')+'"]');
  if(p)p.classList.add('selected');
  showStatePanel(s);
  renderStateTable(s);
  var _s1=document.getElementById('stateSel');if(_s1)_s1.value=s;
}
function showStatePanel(s){
  const sd=getSD(s);const allCMs=getCMs(s);
  const cms=partyFilter==='ALL'?allCMs:allCMs.filter(c=>c.party===partyFilter);
  document.getElementById('rpTitle').textContent=s;
  document.getElementById('rpSub').textContent=`${allCMs.length} leader${allCMs.length>1?'s':''} tracked · Apr–Jul 2026`;
  const pc=pColor(getPP(s));const pp=getPP(s);
  let h='';
  if(!allCMs.length){h+=`<div style="padding:26px 16px;text-align:center;color:var(--muted);font-size:12px;line-height:1.6">No Chief Minister tracked for <strong>${s}</strong> — isliye count nahi dikhaya gaya.</div>`;}
  if(sd&&allCMs.length){
    h+=`<div class="state-hero"><div class="sh-top"><div class="sh-name">${s}</div><span class="sh-party-badge" style="background:${pc}20;color:${pc};border:1.5px solid ${pc}50">${pp}</span></div><div class="sh-kpis"><div class="sh-kpi"><div class="sh-kpi-val">${sd.tweets}</div><div class="sh-kpi-lbl">Tweets</div></div><div class="sh-kpi"><div class="sh-kpi-val">${fmt(sd.views)}</div><div class="sh-kpi-lbl">Views</div></div><div class="sh-kpi"><div class="sh-kpi-val">${fmt(sd.likes)}</div><div class="sh-kpi-lbl">Likes</div></div></div><div class="sh-sent-row"><div class="sh-sent-item"><div class="sh-sent-val" style="color:#F57C00">${sd.neu}</div><div class="sh-sent-lbl">Neutral</div></div><div class="sh-sent-item"><div class="sh-sent-val" style="color:#2E7D32">${sd.pos}</div><div class="sh-sent-lbl">Positive</div></div><div class="sh-sent-item"><div class="sh-sent-val" style="color:#C62828">${sd.neg}</div><div class="sh-sent-lbl">Negative</div></div></div></div>`;
  }
  if(cms.length){
    h+=`<div class="cm-section"><div class="cm-sec-title">Leaders</div>`;
    [...cms].sort((a,b)=>b.views-a.views).forEach(c=>{
      const cp=pColor(c.party);const ini=c.name.split(' ').slice(0,2).map(w=>w[0]||'').join('');
      h+=`<div class="cm-card" style="--cc:${cp}"><div class="cm-card-head"><div class="cm-avatar" style="background:${cp}">${ini}</div><div style="flex:1;min-width:0"><div class="cm-name">${c.name}</div><div class="cm-handle">@${c.handle}</div><div style="display:flex;gap:4px;margin-top:3px;flex-wrap:wrap"><span class="cm-badge">${c.level==='Chief Minister'?'&#128081; CM':'&#9889; Dy.CM'}</span><span class="cm-badge" style="background:${cp}18;color:${cp}">${c.party.length>12?c.party.slice(0,12)+'&hellip;':c.party}</span></div></div></div><div class="cm-stats"><div class="cm-stat"><div class="cm-stat-val">${c.tweets}</div><div class="cm-stat-lbl">Tweets</div></div><div class="cm-stat"><div class="cm-stat-val">${fmt(c.views)}</div><div class="cm-stat-lbl">Views</div></div><div class="cm-stat"><div class="cm-stat-val">${fmt(c.followers)}</div><div class="cm-stat-lbl">Followers</div></div></div><div class="cm-sent-mini"><div class="csm csm-n">Neu: ${c.neu}</div><div class="csm csm-p">Pos: ${c.pos}</div><div class="csm csm-neg">Neg: ${c.neg}</div></div></div>`;
    });
    h+=`</div>`;
  }
  h+=`<div class="cmx-chart-box"><div class="cb-title">Sentiment Distribution</div><div style="position:relative;height:160px"><canvas id="cmSentChart"></canvas></div></div>`;
  h+=`<div class="cmx-chart-box"><div class="cb-title">Views by Leader</div><div style="position:relative;height:${Math.max(120,allCMs.length*42)}px"><canvas id="cmViewsChart"></canvas></div></div>`;
  h+=`<button class="back-btn" onclick="clearSel()">&larr; Back to All States</button>`;
  document.getElementById('rpContent').innerHTML=h;
  if(sd){
    const ctx1=document.getElementById('cmSentChart');
    if(sentChart){sentChart.destroy();sentChart=null}
    sentChart=new Chart(ctx1,{type:'doughnut',data:{labels:['Neutral','Positive','Negative'],datasets:[{data:[sd.neu,sd.pos,sd.neg],backgroundColor:['#FFA726AA','#66BB6AAA','#EF5350AA'],borderColor:['#FF8F00','#43A047','#E53935'],borderWidth:2,hoverOffset:6}]},options:{responsive:true,maintainAspectRatio:false,cutout:'58%',plugins:{legend:{display:true,position:'right',labels:{color:'#333',font:{size:10,weight:'600'},padding:8,usePointStyle:true}},datalabels:{display:true,color:'#fff',font:{size:10,weight:'700'},formatter:v=>v>0?v:''}}}});
  }
  const leaders=[...allCMs].sort((a,b)=>b.views-a.views);
  if(leaders.length){
    const ctx2=document.getElementById('cmViewsChart');
    if(viewsChart){viewsChart.destroy();viewsChart=null}
    viewsChart=new Chart(ctx2,{type:'bar',data:{labels:leaders.map(l=>l.name.length>22?l.name.slice(0,22)+'…':l.name),datasets:[{data:leaders.map(l=>l.views),backgroundColor:leaders.map(l=>pColor(l.party)+'55'),borderColor:leaders.map(l=>pColor(l.party)),borderWidth:2,borderRadius:6}]},options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',layout:{padding:{right:55}},plugins:{legend:{display:false},datalabels:{display:true,anchor:'end',align:'end',color:'#444',font:{size:9,weight:'700'},formatter:v=>fmt(v),clamp:true}},scales:{x:{ticks:{color:'#888',font:{size:8},callback:v=>fmt(v)},grid:{color:'#f0f0f0'}},y:{ticks:{color:'#333',font:{size:10,weight:'600'}},grid:{display:false}}}}});
  }
}
function clearSel(){selectedState=null;document.querySelectorAll('.state-path').forEach(p=>p.classList.remove('selected'));renderDefaultPanel()}
function renderDefaultPanel(){
  if(!selectedState){restoreMainTable();var _s2=document.getElementById('stateSel');if(_s2)_s2.value='';}
  document.getElementById('rpTitle').textContent='State CMs — Twitter Stats';
  document.getElementById('rpSub').textContent='Click any state on the map · Ranked by total views';
  let list=[...STATE_DATA].sort((a,b)=>b.views-a.views).filter(sd=>getCMs(sd.state).length>0);
