    h+='<tr><td style="background:#FCEFCB;font-weight:700;padding:8px;width:24%;border:1px solid #f0e6d8;'+PCE+'">Topic</td><td style="background:#E65100;color:#fff;font-weight:700;padding:8px;border:1px solid #f0e6d8;'+PCE+'">'+esc(rep.topic)+'</td></tr>';
    h+='<tr><td style="background:#FCEFCB;font-weight:700;padding:8px;border:1px solid #f0e6d8;'+PCE+'">Keywords entered</td><td style="padding:8px;border:1px solid #f0e6d8;font-weight:600;color:#B23400">'+esc((rep.keywords||[]).join(', '))+'</td></tr>';
    h+='<tr><td style="background:#FCEFCB;font-weight:700;padding:8px;border:1px solid #f0e6d8;'+PCE+'">Hashtags used</td><td style="padding:8px;border:1px solid #f0e6d8">'+((rep.hashtags&&rep.hashtags.length)?rep.hashtags.slice(0,14).map(function(x){return esc(x.tag)+" ("+x.count+")";}).join("  ·  "):"— none in matched tweets")+'</td></tr>';
    if(rep.mentions&&rep.mentions.length){h+='<tr><td style="background:#FCEFCB;font-weight:700;padding:8px;border:1px solid #f0e6d8;'+PCE+'">Mentions (@)</td><td style="padding:8px;border:1px solid #f0e6d8">'+rep.mentions.slice(0,10).map(function(x){return '<span style="display:inline-block;background:#FFF3E5;border:1px solid #f0d0b0;border-radius:5px;padding:2px 7px;margin:2px;font-size:11px;color:#B23400;font-weight:600">'+esc(x.m)+' ('+x.count+')</span>';}).join('')+'</td></tr>';}
    h+='<tr><td style="background:#FCEFCB;font-weight:700;padding:8px;border:1px solid #f0e6d8;'+PCE+'">Handles (who tweeted)</td><td style="padding:8px;border:1px solid #f0e6d8">'+((rep.handles&&rep.handles.length)?(rep.handles.slice(0,16).map(function(x){return "@"+esc(x.h)+" ("+x.count+")";}).join("  ·  ")+(rep.handles.length>16?("   +"+(rep.handles.length-16)+" more"):"")):"—")+'</td></tr>';
    h+='<tr><td style="background:#FCEFCB;font-weight:700;padding:8px;border:1px solid #f0e6d8;'+PCE+'">Tracking Window</td><td style="padding:8px;border:1px solid #f0e6d8">'+esc(rep.trackingWindow||rep.dateRange)+'</td></tr></table>';
    h+=band('Overall Volume Summary');
