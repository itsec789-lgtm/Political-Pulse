window.profFillParty=function(){var sel=document.getElementById('profParty');if(!sel||sel.options.length>1)return;var pc={};PROF.forEach(function(c){if(c.party)pc[c.party]=(pc[c.party]||0)+1;});var ps=Object.keys(pc).sort();sel.innerHTML='<option value="all">All Parties</option>'+ps.map(function(p){return '<option value="'+p+'">'+p+'</option>';}).join('');};
window.profPresetChange=function(){var DD=window.PHD_DATES||[];var v=(document.getElementById('profPreset')||{}).value;if(v!=='custom'&&DD.length){var t=DD[DD.length-1],ff=(v==='all')?DD[0]:(v==='today'?DD[DD.length-1]:DD[Math.max(0,DD.length-parseInt(v,10))]);var fe=document.getElementById('profFrom'),te=document.getElementById('profTo');if(fe)fe.value=ff;if(te)te.value=t;}renderCMGrid();};
window.profReset=function(){var p=document.getElementById('profPreset');if(p)p.value='all';var pa=document.getElementById('profParty');if(pa)pa.value='all';var DD=window.PHD_DATES||[];var fe=document.getElementById('profFrom'),te=document.getElementById('profTo');if(fe&&DD.length)fe.value=DD[0];if(te&&DD.length)te.value=DD[DD.length-1];renderCMGrid();};
function renderCMGrid(){var _pf=(document.getElementById('profFrom')||{}).value||'';var _pt=(document.getElementById('profTo')||{}).value||'';var _pp=(document.getElementById('profParty')||{}).value||'all';var _pool=PROF.filter(function(c){return _pp==='all'||c.party===_pp;});var _rows=_pool.map(function(c0,i){var c=(window._applyDate?window._applyDate(c0,_pf,_pt):c0);var s=cmStats(c);var col=pc(s.party);var nm=esc(s.name.replace(/\(.*\)/,'').trim());var dz=(s.h==='narendramodi')?'PM':'CM';var avgV=s.tw?Math.round(s.vw/s.tw):0;var avgL=s.tw?Math.round(s.lk/s.tw):0;var fg=c.followings||0;return '<tr data-name="'+esc((nm+' '+s.state+' '+s.party+' @'+s.h).toLowerCase())+'" onclick="openProfile(\''+s.h+'\')">'+'<td>'+esc(s.state)+'</td>'+'<td><div class="cm-nmcell"><div class="cm-av" style="background:'+col+';position:relative;overflow:hidden">'+ini(s.name)+photoImg(s.h)+'</div><div><div class="nm">'+nm+'</div><div class="hd">@'+esc(s.h)+'</div></div></div></td>'+'<td><span class="cm-badge">'+dz+'</span></td>'+'<td><span class="party-chip" style="background:'+col+'18;color:'+col+'">'+esc(shortP(s.party))+'</span></td>'+'<td class="r cm-tnum">'+uf(s.followers)+'</td>'+'<td class="r cm-tnum">'+uf(fg)+'</td>'+'<td class="r cm-tnum">'+uf(s.tw)+'</td>'+'<td class="r cm-tnum">'+uf(avgV)+'</td>'+'<td class="r cm-tnum">'+uf(avgL)+'</td>'+'<td class="r"><button class="cm-pf-btn" onclick="event.stopPropagation();openProfile(\''+s.h+'\')">View Profile \u2192</button></td>'+'</tr>';}).join('');var _html='<table class="cm-table"><thead><tr><th>State</th><th>Name</th><th>Designation</th><th>Party</th><th class="r">Followers</th><th class="r">Following</th><th class="r">Tweets</th><th class="r">Avg Views/Post</th><th class="r">Avg Likes/Post</th><th class="r">Action</th></tr></thead><tbody>'+_rows+'</tbody></table>';var g=document.getElementById('cmGrid');if(g)g.innerHTML=_html;var cc=document.getElementById('cmCount');if(cc)cc.textContent=PROF.length;}
window.openProfile=function(h){var c=PROF.filter(function(x){return x.h===h})[0];if(!c)return;var s=cmStats(c);var col=pc(s.party);var tot=s.pos+s.neu+s.neg||1;var avg=s.tw?Math.round(s.vw/s.tw):0;var avgl=s.tw?Math.round(s.lk/s.tw):0;var nm=s.name.replace(/\(.*\)/,'').trim();var isPM=(h==='narendramodi');var role=isPM?'Prime Minister':'Chief Minister';var bio=BIO[h]||(esc(nm)+' is the '+role+' of '+esc(s.state)+', representing the '+esc(s.party)+'.');var det=DET[h]||{};var con=c.loc||'\u2014';var pP=Math.round(s.pos/tot*100),nP=Math.round(s.neu/tot*100),gP=Math.round(s.neg/tot*100);var age=det.born?(2026-parseInt(((det.born.match(/\d{4}/))||[''])[0])):0;var ageS=age?String(age):'\u2014';var rf=RK_F[h]||0,rv=RK_V[h]||0,rtk=RK_T[h]||0;var NL=PROF.length;var standing='<div class="pf-sec">Standing Among '+NL+' Tracked Leaders</div><div class="pf-stats"><div class="pf-st o"><b>#'+rf+'</b><span>Followers Rank</span></div><div class="pf-st g"><b>#'+rv+'</b><span>Views Rank</span></div><div class="pf-st b"><b>#'+rtk+'</b><span>Tweets Rank</span></div><div class="pf-st r"><b>'+ageS+'</b><span>Age</span></div></div>';var hl=HL[h];var hlHTML=(hl&&hl.length&&hl[0]!=='\u2014')?('<div class="pf-sec">Key Highlights</div><ul class="pf-hl">'+hl.map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ul>'):'';var rows=[['Role',role],['State / UT',s.state],['Party',shortP(s.party)],['Constituency',con]];if(det.born)rows.push(['Born',det.born]);if(det.edu)rows.push(['Education',det.edu]);rows.push(['In office since',det.since||'\u2014']);rows.push(['X Handle','@'+h]);var detHTML=rows.map(function(r){return '<div class="pf-d"><span>'+esc(r[0])+'</span><b>'+esc(String(r[1]))+'</b></div>'}).join('');var jm=JM[h];var jmHTML='';if(jm&&jm.length){jmHTML='<div class="pf-sec">Career Journey</div><div class="pf-tl">'+jm.map(function(t){return '<div class="pf-tli"><div class="pf-yr">'+esc(String(t[0]))+'</div><div class="pf-ev">'+esc(t[1])+'</div></div>'}).join('')+'</div>';}var an='In Apr–Jul 2026, '+esc(nm)+' posted '+uf(s.tw)+' tweets that drew '+uf(s.vw)+' views and '+uf(s.lk)+' likes (~'+uf(avg)+' views and '+uf(avgl)+' likes per post). The tone was '+nP+'% neutral, '+pP+'% positive and '+gP+'% negative \u2014 a broadly '+(gP<10?'favourable':(gP<20?'mixed':'contested'))+' reception.';document.getElementById('pfCard').innerHTML='<button class="pf-x" onclick="closeProfile()">\u2715</button>'+'<div class="pf-head"><div class="pf-av" style="background:'+col+';position:relative;overflow:hidden">'+ini(s.name)+photoImg(h)+'</div><div style="flex:1"><div class="pf-nm">'+esc(nm)+'</div><div class="pf-role" style="color:'+col+'">'+esc(role)+' \u2014 '+esc(s.state)+'</div><div class="pf-sub">@'+esc(h)+' \u00b7 '+uf(s.followers)+' followers</div><div style="margin-top:6px"><span class="party-chip" style="background:'+col+'18;color:'+col+'">'+esc(shortP(s.party))+'</span></div></div></div>'+'<div class="pf-sec">Key Stats \u00b7 Apr–Jul 2026</div><div class="pf-stats"><div class="pf-st o"><b>'+uf(s.followers)+'</b><span>Followers</span></div><div class="pf-st b"><b>'+uf(s.tw)+'</b><span>Tweets</span></div><div class="pf-st g"><b>'+uf(s.vw)+'</b><span>Total Views</span></div><div class="pf-st r"><b>'+uf(avg)+'</b><span>Avg Views/Post</span></div></div>'+standing+'<div class="pf-sec">X (Twitter) Engagement</div><div class="pf-kpis"><div class="pf-k"><b>'+uf(s.lk)+'</b><span>Likes</span></div><div class="pf-k"><b>'+uf(s.rt)+'</b><span>Retweets</span></div><div class="pf-k"><b>'+uf(avgl)+'</b><span>Avg Likes/Post</span></div><div class="pf-k"><b>'+s.tw+'</b><span>Posts Tracked</span></div></div>'+'<div class="pf-sec">About</div><div class="pf-bio">'+bio+'</div>'+hlHTML+'<div class="pf-sec">Personal Details</div><div class="pf-dgrid">'+detHTML+'</div>'+jmHTML+'<div class="pf-sec">Activity Analysis</div><div class="pf-an">'+an+'</div>';var m=document.getElementById('profileModal');if(m)m.classList.add('show');scanPhotos()}
window.closeProfile=function(){const m=document.getElementById('profileModal');if(m)m.classList.remove('show')}

