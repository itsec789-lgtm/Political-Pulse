function g2d(g){return GEO2DATA[g]||g}
function fmt(n){n=Math.round(n);if(n>=1e7)return(n/1e7).toFixed(2)+' Cr';if(n>=1e5)return(n/1e5).toFixed(2)+' L';if(n>=1e3)return(n/1e3).toFixed(1)+'K';return n.toLocaleString('en-IN')}
function getSD(s){return STATE_DATA.find(x=>x.state===s)}
function getCMs(s){return CM_DATA.filter(c=>c.state===s)}
function getPP(s){const cm=getCMs(s).find(c=>c.level==='Chief Minister');if(cm)return cm.party;const all=getCMs(s);return all.length?all[0].party:'OTHER'}
const maxV=Math.max(...STATE_DATA.map(s=>s.views));
const maxT=Math.max(...STATE_DATA.map(s=>s.tweets));
let mapMode='party',selectedState=null,partyFilter='ALL',sentChart=null,viewsChart=null;

function viewsRGB(t){return`rgb(${Math.round(255-t*200)},${Math.round(120+t*80)},20)`}
function tweetsRGB(t){return`rgb(${Math.round(20+t*10)},${Math.round(80+t*110)},${Math.round(40+t*120)})`}
function getStateColor(s){
  if(mapMode==='views'){const sd=getSD(s);if(!sd)return'#8c8c8c';return viewsRGB(sd.views/maxV)}
  if(mapMode==='tweets'){const sd=getSD(s);if(!sd)return'#8c8c8c';return tweetsRGB(sd.tweets/maxT)}
  if(mapMode==='sentiment'){const sd=getSD(s);if(!sd)return'#8c8c8c';const tot=sd.pos+sd.neg+sd.neu||1;if(sd.neg/tot>0.15)return'#E53935';if(sd.pos/tot>0.4)return'#43A047';return'#FB8C00'}
  const cms=getCMs(s);if(!cms.length)return'#8c8c8c';return pColor(getPP(s));
}

