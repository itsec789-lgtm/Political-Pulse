@media(max-width:900px){.main-wrapper{grid-template-columns:1fr;height:auto}.map-panel{height:70vw;min-height:300px}.right-panel{height:auto;overflow-y:visible}}

/* embedded CM map overrides */
#sec-states-cm .main-wrapper{height:600px;border:1.5px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:16px}
#sec-states-cm .table-section{padding:14px 0 0;border-top:none}
#sec-states-cm .map-panel{border-radius:14px 0 0 14px}
