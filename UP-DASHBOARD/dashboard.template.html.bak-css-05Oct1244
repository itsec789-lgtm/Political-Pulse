window.renderPartyTweetChart=function(){const r=partyRows(pState,pLevel);const el=cd('partyTweetChart');if(!el)return;
 new Chart(el,{type:'bar',data:{labels:r.map(x=>x.p),datasets:[{data:r.map(x=>x.tw),backgroundColor:r.map(x=>pc(x.p)+pAlpha(x.p,'88')),borderColor:r.map(x=>pc(x.p)),borderWidth:2,borderRadius:6}]},options:{responsive:true,maintainAspectRatio:false,layout:{padding:{top:18}},plugins:{legend:{display:false},datalabels:{display:true,anchor:'end',align:'end',color:'#444',font:{size:10,weight:'700'},formatter:v=>v>=1000?(v/1000).toFixed(0)+'K':v}},scales:{x:{ticks:{color:'#222',font:{size:11,weight:'700'}},grid:{display:false}},y:{ticks:{color:'#555',font:{size:9},callback:v=>v>=1000?(v/1000).toFixed(0)+'K':v},grid:{color:'#ece9e0'}}}}});
 const t=document.getElementById('partyTweetChartTitle');if(t)t.textContent=(pState==='ALL'?'Tweets by Party':'Tweets — '+pState)+(selParty?' · '+selParty:'')};
window.renderPartySentChart2=function(){const r=partyRows(pState,pLevel);const el=cd('partySentChart2');if(!el)return;
 const mk=(lbl,key,col,b)=>({label:lbl,data:r.map(x=>x[key]),backgroundColor:r.map(x=>col+pAlpha(x.p,b)),borderColor:col,borderWidth:1.5,borderRadius:3});
 new Chart(el,{type:'bar',data:{labels:r.map(x=>x.p),datasets:[mk('Neutral','neu','#E65100','60'),mk('Positive','pos','#2E7D32','90'),mk('Negative','neg','#C62828','90')]},options:{responsive:true,maintainAspectRatio:false,layout:{padding:{top:14}},plugins:{legend:{display:true,position:'top',labels:{font:{size:10},usePointStyle:true}},datalabels:{display:true,anchor:'end',align:'end',color:'#555',font:{size:8,weight:'700'},formatter:v=>v>=1000?(v/1000).toFixed(0)+'K':v}},scales:{x:{ticks:{color:'#222',font:{size:10,weight:'700'}},grid:{display:false}},y:{ticks:{color:'#555',font:{size:9},callback:v=>v>=1000?(v/1000).toFixed(0)+'K':v},grid:{color:'#ece9e0'}}}}});
 const t=document.getElementById('partySentChartTitle');if(t)t.textContent=(pState==='ALL'?'Sentiment by Party':'Sentiment — '+pState)+(selParty?' · '+selParty:'')};
window.renderPartiesPartyViewsChart=function(){const r=partyRows(pState,pLevel);const el=cd('pPartyViewsChart');if(!el)return;const cols=r.map(x=>pc(x.p)+(selParty&&x.p!==selParty?'33':'cc'));
 new Chart(el,{type:'doughnut',data:{labels:r.map(x=>x.p),datasets:[{data:r.map(x=>x.vw),backgroundColor:cols,borderColor:r.map(x=>pc(x.p)),borderWidth:2.5,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{display:true,position:'right',labels:{color:'#333',font:{size:10,weight:'600'},padding:10,usePointStyle:true}},datalabels:{display:true,color:'#fff',font:{size:9,weight:'700'},formatter:(v,ctx)=>{const t=ctx.chart.data.datasets[0].data.reduce((a,b)=>a+b,0);const p=((v/t)*100).toFixed(0);return p>3?p+'%':''}}}}})};
window.renderPartiesTopHandlesChart=function(){const el=cd('pTopHandlesChart');if(!el)return;
 let arr=UNI.allHandles.filter(h=>(pState==='ALL'||h.state===pState)&&(!pLevel||h.level===pLevel)&&(!selParty||h.party===selParty)).map(h=>({n:h.name||h.h,p:h.party,avg:h.tw>0?Math.round(h.vw/h.tw):0})).sort((a,b)=>b.avg-a.avg).slice(0,8);
 const tt=document.getElementById('topHandlesChartTitle');if(tt)tt.textContent='Top Handles — Avg Views/Post'+(selParty?' · '+selParty:(pState==='ALL'?'':' · '+pState));
 new Chart(el,{type:'bar',data:{labels:arr.map(x=>x.n.length>20?x.n.slice(0,20)+'…':x.n),datasets:[{data:arr.map(x=>x.avg),backgroundColor:arr.map(x=>pc(x.p)+'33'),borderColor:arr.map(x=>pc(x.p)),borderWidth:2,borderRadius:6}]},options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',layout:{padding:{right:62}},plugins:{legend:{display:false},datalabels:{display:true,anchor:'end',align:'end',color:'#555',font:{size:9,weight:'700'},formatter:v=>uf(v)}},scales:{x:{ticks:{color:'#555',font:{size:9},callback:v=>uf(v)},grid:{color:'#ece9e0'}},y:{ticks:{color:'#222',font:{size:9,weight:'600'}},grid:{display:false}}}}})};
window.upPartyClick=function(p){selParty=(selParty===p?null:p);
 document.querySelectorAll('#partyCardsSection .pcard').forEach(c=>c.classList.toggle('active-party',c.getAttribute('data-p')===selParty));
 const bn=document.getElementById('activePartyBanner');if(bn){if(selParty){const v=(partyRows(pState,pLevel).find(function(x){return x.p===selParty}))||{};bn.style.display='flex';const tx=document.getElementById('activePartyBannerText');if(tx)tx.textContent='Showing: '+selParty+(pState==='ALL'?' (All India)':' in '+pState);const st=document.getElementById('activePartyBannerStats');if(st&&v)st.textContent=(v.tw||0).toLocaleString('en-IN')+' tweets · '+uf(v.vw)+' views · '+uf(v.lk)+' likes · '+(v.h||0)+' handles';}else bn.style.display='none';}
 window.renderPartyTweetChart();window.renderPartySentChart2();window.renderPartiesPartyViewsChart();window.renderPartiesTopHandlesChart()};
window.selectPartyCard=function(p){if(!p){selParty=null;document.querySelectorAll('#partyCardsSection .pcard').forEach(c=>c.classList.remove('active-party'));const bn=document.getElementById('activePartyBanner');if(bn)bn.style.display='none';window.renderPartyTweetChart();window.renderPartySentChart2();window.renderPartiesPartyViewsChart();window.renderPartiesTopHandlesChart();}else window.upPartyClick(p)};

