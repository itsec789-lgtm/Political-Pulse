<!-- ===== SENTIMENT 8-CATEGORY CORE (sentx v1) ===== -->
<script>
/* Ek hi jagah se saare sentiment naam, rang aur ginti aati hai.
   Pehle poore dashboard me sirf 3 (pos/neu/neg) hardcode the.
   Mongo ke 'Sentiment' column me asal me ye values hain:
   Neutral, Positive, Negative, Pro-BJP, Anti-BJP, Pro-Govt, Anti-Govt
   -- aur jahan value khaali ho wo 'No-Sentiment'.
   pos/neu/neg key jaan-boojh kar purane naam hi hain, taaki purana data
   aur purana code bina toote chalta rahe. */
window.SENTX = (function () {
  var CATS = [
    { k: 'probjp',   label: 'Pro-BJP',      c: '#E65100' },
    { k: 'antigovt', label: 'Anti-Govt',    c: '#AD1457' },
    { k: 'progovt',  label: 'Pro-Govt',     c: '#1565C0' },
    { k: 'pos',      label: 'Positive',     c: '#2E7D32' },
    { k: 'neu',      label: 'Neutral',      c: '#FF8F00' },
    { k: 'antibjp',  label: 'Anti-BJP',     c: '#6A1B9A' },
    { k: 'neg',      label: 'Negative',     c: '#C62828' },
    { k: 'none',     label: 'No-Sentiment', c: '#78909C' }
  ];
  var BY_K = {}, BY_L = {};
  CATS.forEach(function (o) { BY_K[o.k] = o; BY_L[o.label.toLowerCase().replace(/[^a-z0-9]+/g, '')] = o; });

  function n(o, k) { return (o && +o[k]) || 0; }
  function tot(o) { var t = 0; for (var i = 0; i < CATS.length; i++) t += n(o, CATS[i].k); return t; }
  function pct(o, k) { var t = tot(o) || 1; return n(o, k) * 100 / t; }
  function color(k) { return (BY_K[k] || {}).c || '#78909C'; }
  function label(k) { return (BY_K[k] || {}).label || k; }
  /* raw string ("Pro-BJP", "pro govt", "") -> category object */
  function of(v) {
    var s = String(v == null ? '' : v).toLowerCase().replace(/[^a-z0-9]+/g, '');
    return BY_L[s] || BY_K[s] || BY_L['nosentiment'];
  }
  /* handle/party/state jaisi kisi bhi object list ko jod kar ek ginti */
  function sum(rows) {
    var o = {}; CATS.forEach(function (c) { o[c.k] = 0; });
    (rows || []).forEach(function (r) { CATS.forEach(function (c) { o[c.k] += n(r, c.k); }); });
    return o;
  }
  function blank() { var o = {}; CATS.forEach(function (c) { o[c.k] = 0; }); return o; }
  /* chart ke liye datasets -- har category ka ek */
  function datasets(rows, pick) {
    return CATS.map(function (c) {
      return {
        label: c.label,
        data: (rows || []).map(function (r) { return pick ? pick(r, c.k) : n(r, c.k); }),
        backgroundColor: c.c + '90', borderColor: c.c, borderWidth: 1.4, borderRadius: 3
      };
    });
  }
  return { CATS: CATS, n: n, tot: tot, pct: pct, color: color, label: label,
           of: of, sum: sum, blank: blank, datasets: datasets };
})();

/* ---- sentiment cards (8) -- HTML ek hi jagah se banta hai ---- */
window.sentCardsHTML = function (S, suffix) {
  var X = window.SENTX, T = X.tot(S) || 1;
  return X.CATS.map(function (c) {
    var v = X.n(S, c.k);
    return '<div class="sent-card" data-sk="' + c.k + '" style="border-top:4px solid ' + c.c + '">' +
      '<div class="sent-card-val" style="color:' + c.c + '">' + v.toLocaleString('en-IN') + '</div>' +
      '<div class="sent-card-lbl">' + c.label + (suffix || '') + '</div>' +
      '<div class="sent-card-pct" style="color:' + c.c + '">' + (v * 100 / T).toFixed(1) + '%</div></div>';
  }).join('');
};
</script>
