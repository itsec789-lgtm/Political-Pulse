<script>
/* ==========================================================================
   LIVE UPDATE INDICATOR  (rt-delta)
   --------------------------------------------------------------------------
   Har KPI / count / card / table value ke saath, agar wo PICHHLI baar se
   BADHA hai, to uske aage hara "↑ +1K" dikhata hai, aur value par halka
   count-up + pulse chalata hai.

   Kaise kaam karta hai (aur kyun aise):

   * Naya data aane par server page ko RELOAD kar deta hai
     (/api/version -> location.reload()). Isliye "pichhla value" memory me
     nahi bach sakta -- use localStorage me rakhna padta hai.

   * Value filter badalne par bhi badalti hai, par wo "badhna" nahi hai.
     Isliye har snapshot ek CONTEXT ke saath judta hai:
         scope | tab | party | range
     Filter badla -> context badla -> us context ka apna purana snapshot
     use hota hai. Kabhi bhi BJP ka number All-Parties se compare nahi hota.

   * Date range default (poori range) ho to use "FULL" maana jaata hai --
     kyunki naya data aane par aakhri date apne aap aage badh jaati hai,
     aur agar use context me ginte to har update par context badal jaata
     aur indicator kabhi dikhta hi nahi.

   Sirf BADHNE par dikhta hai (spec ke mutabik). Ghatne par kuch nahi.
   Sab kuch try/catch me hai -- ye module kabhi page ko nahi todega.
   ========================================================================== */
(function () {
  'use strict';

  var STORE = 'ipp_rt_snap_v2';   /* v2: purani (galat rank-based) baseline apne aap chhod di jaati hai */
  var MAXCTX = 24;                 // itne context tak yaad, phir purane hat jaate hain

  /* jin jagah number dikhta hai -- inhi ko track karte hain */
  var SEL = [
    '.kpi-val', '.lv-val', '.lv-sub', '.pstat-val', '.sent-card-val',
    '.cm-stat-val', '.cm-tnum', '.cm-count', '.sh-kpi-val', '.sh-sent-val',
    '.tt-val', '.psent-cnt', '.sbar-cnt', '.td-num', '.pcard-handles',
    '.tbl-box tbody td', '.num'
  ].join(',');

  /* rt-fix v4 : ye kabhi track mat karo.
     .lu-td  = har table ka "LAST UPDATED" column ("20 min ago")
     .bn-upd = breaking-news card ka wahi text
     Inme number hota hai par wo DATA nahi, GHADI hai -- har minute badhta
     hai, isliye inpar bakwaas "↑ +5" lagta tha. */
  var SKIP = '.lu-td,.bn-upd,.lu-th,.rt-up';

  /* ---------------------------------------------------------------- number */
  var UNITS = [
    [/\bcr\b|crore/i, 1e7], [/\bl\b|lakh/i, 1e5],
    [/\bk\b/i, 1e3], [/\bm\b|million/i, 1e6], [/\bb\b|billion/i, 1e9]
  ];

  // "12,34,567" -> 1234567 | "13K" -> 13000 | "1.2 Cr" -> 12000000
  function parseVal(txt) {
    if (txt == null) return null;
    var t = String(txt).trim();
    if (!t || t === '—' || t === '-') return null;
    if (t.indexOf('%') >= 0) return null;          // percent chhod do
    if (/\d{4}-\d{2}-\d{2}|\d{1,2}[:/]\d{2}/.test(t)) return null;  // date/time chhod do
    /* rt-fix v4 : "20 min ago", "2 hours ago", "just now", "1 day ago"
       -- ye ghadi hai, data nahi. Har minute badhti hai. */
    if (/\b(ago|just now|min|mins|minute|minutes|hour|hours|hr|day|days)\b/i.test(t)
        && /\bago\b|just now/i.test(t)) return null;

    var m = t.match(/-?\d[\d,]*(\.\d+)?/);
    if (!m) return null;
    var base = parseFloat(m[0].replace(/,/g, ''));
    if (!isFinite(base)) return null;

    var after = t.slice(m.index + m[0].length, m.index + m[0].length + 6);
    for (var i = 0; i < UNITS.length; i++) {
      if (UNITS[i][0].test(after)) { base *= UNITS[i][1]; break; }
    }
    return base;
  }

  // sample jaisi hi shakl me number wapas -- taaki count-up me format na toote
  function fmtLike(n, sample) {
    var t = String(sample);
    var m = t.match(/-?\d[\d,]*(\.\d+)?/);
    if (!m) return t;
    var numTxt = m[0];
    var pre = t.slice(0, m.index), post = t.slice(m.index + numTxt.length);

    var unit = 1, dec = (numTxt.split('.')[1] || '').length;
    var head = post.slice(0, 6);
    for (var i = 0; i < UNITS.length; i++) {
      if (UNITS[i][0].test(head)) { unit = UNITS[i][1]; break; }
    }
    var v = n / unit, out;
    if (unit > 1) {
      out = v.toFixed(dec);
    } else if (numTxt.indexOf(',') >= 0) {
      out = Math.round(v).toLocaleString('en-IN');
    } else {
      out = dec ? v.toFixed(dec) : String(Math.round(v));
    }
    return pre + out + post;
  }

  // delta ko chhoti shakl me: 1000 -> "1K", 250000 -> "2.5L"
  function fmtDelta(d) {
    d = Math.abs(d);
    if (d >= 1e7) return (d / 1e7).toFixed(d % 1e7 ? 2 : 0).replace(/\.00$/, '') + 'Cr';
    if (d >= 1e5) return (d / 1e5).toFixed(d % 1e5 ? 1 : 0).replace(/\.0$/, '') + 'L';
    if (d >= 1e3) return (d / 1e3).toFixed(d % 1e3 ? 1 : 0).replace(/\.0$/, '') + 'K';
    return Math.round(d).toLocaleString('en-IN');
  }

  /* ------------------------------------------------------------- context */
  function txt(el) { return el ? (el.textContent || '').trim() : ''; }

  /* Value ka apna text -- badge (.rt-up) chhod kar. Badge value ke ANDAR
     lagta hai taaki wo USI line me dikhe ("13K ↑ +1K"), isliye parse karte
     waqt use hata dena zaroori hai. */
  function pureText(el) {
    if (!el) return '';
    var out = '', c = el.childNodes;
    for (var i = 0; i < c.length; i++) {
      if (c[i].nodeType === 3) out += c[i].nodeValue;
      else if (c[i].nodeType === 1 && !(c[i].classList && c[i].classList.contains('rt-up'))) out += c[i].textContent;
    }
    return out.trim();
  }

  /* sirf number wala text node badlo -- badge ko haath mat lagao */
  function setNum(el, str) {
    var c = el.childNodes;
    for (var i = 0; i < c.length; i++) {
      if (c[i].nodeType === 3 && c[i].nodeValue.trim()) { c[i].nodeValue = str; return; }
    }
    el.insertBefore(document.createTextNode(str), el.firstChild);
  }
  function val(id) { var e = document.getElementById(id); return e ? (e.value || '') : ''; }

  /* Date range default ho to "FULL" -- naya data aane par aakhri date
     apne aap badhti hai, use context me ginenge to indicator marr jayega. */
  function rangeSig() {
    var f = val('dashFrom'), t = val('dashTo');
    if (!f && !t) return 'FULL';
    var el = document.getElementById('dashFrom');
    var lo = el ? (el.getAttribute('min') || '') : '';
    var el2 = document.getElementById('dashTo');
    var hi = el2 ? (el2.getAttribute('max') || '') : '';
    if (f === lo && t === hi) return 'FULL';
    return f + '..' + t;
  }

  /* CONTEXT me TAB nahi hai -- jaan-boojh kar.
     Pehle tha, aur wahi bug tha: app page load ke thodi der baad
     '.page-section.active' set karti hai (aur har tab switch par badalti
     hai). Us se context badal jaata tha -> badge saaf ho jaate the aur
     nayi baseline likh di jaati thi, isliye indicator do second me gayab
     ho jaata tha. Tab ek FILTER hai hi nahi -- alag tab ke element ki
     apni alag key hoti hai (key me section id already hai). */
  function sig() {
    var scope = (window.DASH_SCOPE || 'all');
    return [scope, val('dashParty') || 'all', rangeSig()].join('|');
  }

  /* ----------------------------------------------------------------- key */
  function labelFor(el) {
    var p = el.parentElement;
    if (!p) return '';
    var lb = p.querySelector('.kpi-lbl,.lv-lbl,.pstat-lbl,.sent-card-lbl,.cm-stat-lbl,.sh-kpi-lbl,.psent-lbl');
    return lb ? txt(lb).slice(0, 40) : '';
  }

  /* ROW ki asli pehchan.
     PEHLE yahan row.cells[0] use hota tha -- par pehla column '#' (rank) hai.
     Sort/filter badalne par rank #1 par koi DUSRA handle aa jaata tha, aur
     uska number purane handle se compare hota tha -> "12.17 L  ↑ +10.58Cr"
     jaisa bakwaas delta. Isliye ab pehchan @handle se hoti hai (aur wo na
     mile to pehle asli text wale cell se), rank se nahi. */
  function rowKey(row) {
    /* rt-fix v6 -- yahan ek bada bug tha.

       PEHLE:  (row.textContent || '').match(/@[A-Za-z0-9_]{2,}/)

       row.textContent saare cell ka text BINA GAP ke jod deta hai:
           "Narendra Modi" "@narendramodi" "10.7 Cr" "2.7K" ...
              -> "Narendra Modi@narendramodi10.7 Cr2.7K..."
       Regex @ ke baad akshar-ank uthata chala gaya aur AGLE CELL me
       ghus gaya -> key bani "@narendramodi10" (wo 10 followers se aaya).

       Followers 10.7 Cr se 11.2 Cr hote hi key "@narendramodi11" ho
       gayi -- purani key se mel hi nahi khaya, to code ne use bilkul
       nayi row samjha aur badge kabhi nahi lagaya.
       ISI WAJAH se KPI par arrow aata tha par TABLE me kabhi nahi.

       AB: cell-dar-cell dekhte hain. Har cell apne me poora hota hai,
       isliye handle agle cell me ghus hi nahi sakta. X ka handle 15
       akshar se lamba hota nahi, wo cap bhi laga diya. */
    var cells = row.cells, i, c, m;
    for (i = 0; i < cells.length; i++) {
      m = txt(cells[i]).match(/@[A-Za-z0-9_]{2,15}/);
      if (m) return m[0].toLowerCase();
    }
    /* handle na mile to pehla asli-naam wala cell -- rank/number/date nahi */
    for (i = 0; i < cells.length; i++) {
      c = txt(cells[i]);
      if (c && c.length > 1 && !/^[\d.,%+\-↑↓\s]+$/.test(c)) return c.slice(0, 40);
    }
    return null;
  }

  function keyOf(el) {
    if (el.id) return 'id:' + el.id;
    var td = el.closest ? el.closest('td') : null;
    if (td && td.parentElement && td.parentElement.cells) {
      var row = td.parentElement;
      var first = rowKey(row);
      var col = td.cellIndex;
      var tb = td.closest('table');
      var tid = (tb && (tb.id || (tb.className || '').slice(0, 20))) || 't';
      if (first) return 'td:' + tid + ':' + first + ':' + col;
      return null;                                  // bina naam ki row -> chhod do
    }
    var lb = labelFor(el);
    if (lb) {
      var sec = el.closest ? el.closest('.page-section') : null;
      return 'lb:' + ((sec && sec.id) || 'main') + ':' + lb + ':' + (el.className || '');
    }
    return null;
  }

  /* --------------------------------------------------------------- store */
  function load() {
    try { return JSON.parse(localStorage.getItem(STORE) || '{}') || {}; }
    catch (e) { return {}; }
  }
  function save(o) {
    try {
      var k = Object.keys(o);
      if (k.length > MAXCTX) {                       // purane context hata do
        /* rt-fix v4 : record me 't' likha jaata hai, '_t' nahi --
           pehle sort hamesha 0 par chalta tha aur galat context hat jaata. */
        k.sort(function (a, b) { return ((o[a] && o[a].t) || 0) - ((o[b] && o[b].t) || 0); });
        for (var i = 0; i < k.length - MAXCTX; i++) delete o[k[i]];
      }
      localStorage.setItem(STORE, JSON.stringify(o));
    } catch (e) { /* private mode / quota -- chhod do */ }
  }

  /* --------------------------------------------------------------- paint */
  function clearBadges() {
    var b = document.querySelectorAll('.rt-up');
    for (var i = 0; i < b.length; i++) if (b[i].parentNode) b[i].parentNode.removeChild(b[i]);
  }

  function countUp(el, from, to, sample) {
    var dur = 700, t0 = 0;
    var target = fmtLike(to, sample);
    /* "13K" jaisi compact value me 0 decimal hote hain -- beech ke frame
       bhi 13K hi bante hain aur count-up dikhta hi nahi. Isliye animation
       ke dauraan ek decimal jod dete hain, aakhir me asli shakl wapas. */
    var anim = sample;
    var m = String(sample).match(/-?\d[\d,]*(\.\d+)?/);
    if (m && !m[1]) {
      var tail = String(sample).slice(m.index + m[0].length, m.index + m[0].length + 6);
      if (/\bcr\b|crore|\bl\b|lakh|\bk\b|\bm\b|\bb\b/i.test(tail)) {
        anim = String(sample).slice(0, m.index) + m[0] + '.0' + String(sample).slice(m.index + m[0].length);
      }
    }
    function step(ts) {
      if (!t0) t0 = ts;
      var p = Math.min(1, (ts - t0) / dur);
      var e = 1 - Math.pow(1 - p, 3);               // ease-out
      if (p < 1) { setNum(el, fmtLike(from + (to - from) * e, anim)); requestAnimationFrame(step); }
      else setNum(el, target);                      // aakhir me bilkul sahi text
    }
    requestAnimationFrame(step);
  }

  function badge(el, d) {
    if (!el) return;
    var s = document.createElement('span');
    s.className = 'rt-up';
    s.setAttribute('aria-label', 'increased by ' + fmtDelta(d));
    s.textContent = '↑ +' + fmtDelta(d);
    el.appendChild(s);                              // usi line me: "13K ↑ +1K"
  }

  /* ---------------------------------------------------------------- main */
  /* ctx ka record: { t, b:{key:number}, d:{key:[delta, kab]} }
     b = baseline (aakhri dekha hua value)
     d = jo delta dikhana hai -- ye localStorage me bhi jaata hai, isliye
         page dobara reload ho (server naya data aane par reload karta hai)
         to bhi badge dikhta rehta hai, jab tak value phir se na badle. */
  /* rt-fix v5 : badge ab GHADI se nahi, DATA ke version se hatta hai.
     Pehle 6 ghante ka TTL tha -- yaani badge waqt dekh kar gayab ho jaata,
     chahe naya data aaya ho ya nahi. Ab badge tab tak rehta hai jab tak
     AGLA data update na aa jaaye. Version wahi hai jo header ke
     "x min ago" ke liye aata hai (/api/version -> meta.lastUpdate),
     jise upd module window.IPP_DATA_VER me rakh deta hai.
     7 din ka cap sirf ek safety net hai (version kabhi na mile to). */
  var DELTA_TTL = 7 * 24 * 60 * 60 * 1000;
  function dataVer() { try { return String(window.IPP_DATA_VER || ''); } catch (e) { return ''; } }
  var CUR = null;                          // abhi ke context ka record
  var CTX = null;
  var SEEN = {};                           // is session me kaunsi key process ho chuki
  var painting = false, dirty = false, saveT = null;

  /* Baseline turant nahi likhte (har scan par localStorage likhna mehnga hai),
     par zyada der bhi nahi ruk sakte -- server naya data aane par page RELOAD
     kar deta hai, aur agar tab tak baseline likhi hi nahi gayi to agli baar
     delta nikalne ke liye kuch hota hi nahi. Isliye chhota debounce +
     page band/chhupte waqt turant flush. */
  function flush() {
    if (!dirty || !CTX || !CUR) return;
    clearTimeout(saveT);
    var st = load(); CUR.t = Date.now(); st[CTX] = CUR; save(st); dirty = false;
  }

  function persist() {
    dirty = true;
    clearTimeout(saveT);
    saveT = setTimeout(flush, 400);
  }

  /* rt-fix v4 : purani baseline aage le aao (sirf jab range ka
     end aage badha ho). ctx = "scope|party|range" */
  function carryOver(st, ctx) {
    try {
      var a = String(ctx).split('|');
      if (a.length < 3) return null;
      var head = a[0] + '|' + a[1] + '|';
      var now = a.slice(2).join('|');
      var nf = now.split('..');                       // "from..to"  ya  "FULL"
      var best = null, bestT = -1;
      for (var k in st) {
        if (k.indexOf(head) !== 0 || k === ctx) continue;
        var old = k.slice(head.length);
        var of = old.split('..');
        var fit = false;
        if (old === 'FULL' || now === 'FULL') {
          /* FULL <-> poori range ka wahi matlab hai; data badhne par
             aksar yahi flip hota hai */
          fit = true;
        } else if (of.length === 2 && nf.length === 2 && of[0] === nf[0] && nf[1] >= of[1]) {
          fit = true;                                  // start wahi, end aage
        }
        if (!fit) continue;
        var t = (st[k] && st[k].t) || 0;
        if (t > bestT) { bestT = t; best = st[k]; }
      }
      if (!best) return null;
      /* baseline le lo, par purane badge (d) nahi -- wo us range ke the */
      var b = {};
      for (var kk in (best.b || {})) b[kk] = best.b[kk];
      return { t: bestT, b: b, d: {}, ver: best.ver || '' };   /* rt-fix v5 */
    } catch (e) { return null; }
  }

  function scan() {
    var out = [];
    var els;
    try { els = document.querySelectorAll(SEL); } catch (e) { return out; }
    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      if (el.classList && el.classList.contains('rt-up')) continue;
      /* rt-fix v4 : ghadi wale cell chhod do */
      try { if (el.closest && el.closest(SKIP)) continue; } catch (e2) {}
      /* rt-fix v5 : pehle yahan ye tha --
             if (el.offsetParent === null && ...) continue;   // chhupa hua
         Yaani jo element us waqt screen par nahi tha (doosre tab me), use
         bilkul chhod diya jaata tha. Naya data aane par page reload hota
         hai aur SIRF khule tab ke number purane se mile jaate the. Baaki
         tab ke number pehli baar tab dikhte the jab aap wahan jaate --
         aur "pehli baar" ka matlab hai "purana value hai hi nahi", to
         badge kabhi lagta hi nahi tha.
         Ab sab padhte hain. Tab ke div DOM me hote hi hain, bas CSS se
         chhupe hote hain -- padhne me koi dikkat nahi. */
      var t = pureText(el);
      var n = parseVal(t);
      if (n === null) continue;
      var k = keyOf(el);
      if (!k) continue;
      out.push({ el: el, key: k, n: n, txt: t });
    }
    return out;
  }

  function run(animate) {
    if (painting) return;
    painting = true;
    try {
      var ctx = sig();

      /* Context SIRF tab badalta hai jab asli filter badle (party/range/scope).
         Tab switch se ab kuch nahi hota. */
      if (ctx !== CTX) {
        clearBadges();
        CTX = ctx; SEEN = {};
        var st = load();
        /* rt-fix v4 : ye hi asli bug tha.
           Naya data aane par date-range ka END aage badh jaata hai, isliye
           context string badal jaati thi aur purani baseline chhoot jaati
           thi -> indicator kabhi nahi dikhta tha. Ab agar sirf END aage
           badha hai (scope, party aur START wahi ke wahi), to purani
           baseline utha lete hain. Range SIKUDNE par nahi -- tab number
           ghatenge, aur ghatne par waise bhi badge nahi lagta. */
        CUR = st[ctx] || carryOver(st, ctx) || { t: 0, b: {}, d: {} };
        if (!CUR.b) CUR.b = {};
        if (!CUR.d) CUR.d = {};
        var now0 = Date.now();
        for (var dk in CUR.d) {                       // bahut purane badge hata do
          if (!CUR.d[dk] || (now0 - (CUR.d[dk][1] || 0)) > DELTA_TTL) delete CUR.d[dk];
        }
      }

      /* rt-fix v5 : naya data aaya? to pichhle update ke badge
         hata do -- is update ke apne badge abhi neeche bante hain.
         Ye ek hi baar hota hai, har version par. Isliye jo tab aap BAAD
         me kholte ho uske badge bhi bach jaate hain (version wahi hai,
         dobara wipe nahi hota). */
      var ver = dataVer();
      if (ver && CUR.ver !== ver) {
        if (CUR.ver) { CUR.d = {}; clearBadges(); }
        CUR.ver = ver;
        persist();
      }

      var items = scan();
      if (!items.length) { painting = false; return; }
      var now = Date.now(), justUp = {};

      for (var i = 0; i < items.length; i++) {
        var it = items[i];
        if (SEEN[it.key]) continue;                   // is session me pehle hi dekh liya
        SEEN[it.key] = 1;

        var old = CUR.b[it.key];
        if (typeof old === 'number') {
          if (it.n > old) {                           // BADHA -> naya delta
            /* SANITY: ek update me value 3 guna se zyada nahi badhti.
               Itna bada "jump" matlab hum galti se do alag cheezein compare
               kar rahe hain (row dobara sort ho gayi, ya key takra gayi).
               Aise me badge mat dikhao -- chupchap nayi baseline le lo. */
            if (old >= 100 && it.n > old * 3) {
              delete CUR.d[it.key];
              CUR.b[it.key] = it.n;
              persist();
              continue;
            }
            CUR.d[it.key] = [it.n - old, now];
            justUp[it.key] = old;
            CUR.b[it.key] = it.n;
            persist();
          } else if (it.n < old) {                    // ghata -> purana badge hatao
            delete CUR.d[it.key];
            CUR.b[it.key] = it.n;
            persist();
          }
          // barabar hai -> baseline aur purana delta dono waise hi rehne do
        } else {
          CUR.b[it.key] = it.n;                       // pehli baar dikha (lazy tab bhi)
          persist();
        }
      }

      /* badge lagao -- naye bhi, aur pichhle update wale bhi (reload ke baad) */
      for (var k = 0; k < items.length; k++) {
        var itm = items[k], rec = CUR.d[itm.key];
        if (!rec) continue;
        if ((now - (rec[1] || 0)) > DELTA_TTL) { delete CUR.d[itm.key]; continue; }
        if (itm.el.querySelector && itm.el.querySelector('.rt-up')) continue;   // pehle se laga hai
        badge(itm.el, rec[0]);
        if (animate && itm.key in justUp) {           // animation sirf abhi badhe hue par
          itm.el.classList.add('rt-pulse');
          (function (e) { setTimeout(function () { e.classList.remove('rt-pulse'); }, 1400); })(itm.el);
          countUp(itm.el, justUp[itm.key], itm.n, itm.txt);
        }
      }
    } catch (e) { /* kabhi page mat todo */ }
    painting = false;
  }

  /* ------------------------------------------------------------- trigger */
  var timer = null;
  function schedule(animate) {
    clearTimeout(timer);
    timer = setTimeout(function () { run(animate); }, 220);
  }

  function boot() {
    run(true);                                     // pehli baar -- animation ke saath
    try {
      var mo = new MutationObserver(function () { schedule(false); });
      mo.observe(document.body, { childList: true, subtree: true, characterData: true });
    } catch (e) { }
    // filter / tab badle -> naya context
    ['dashParty', 'dashFrom', 'dashTo', 'dashPreset'].forEach(function (id) {
      var e = document.getElementById(id);
      if (e) e.addEventListener('change', function () { schedule(true); });
    });
    document.addEventListener('click', function (ev) {
      var t = ev.target;
      if (t && t.closest && t.closest('.mnav-tab,.ptab')) schedule(false);
    }, true);
  }

  /* page band ho / tab chhupe -> baseline turant likh do */
  try {
    window.addEventListener('pagehide', flush);
    window.addEventListener('beforeunload', flush);
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') flush();
    });
  } catch (e) { }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { setTimeout(boot, 700); });
  else setTimeout(boot, 700);

  /* rt-fix v4 : console me chalao -> rtDiag()
     Saaf batata hai ki indicator kyun dikh raha hai ya kyun nahi. */
  window.rtDiag = function () {
    var items = scan(), st = load();
    var o = {
      context: sig(),
      'is context ki baseline mili': !!st[sig()],
      'kitne number track ho rahe hain': items.length,
      'baseline me kitne': CUR ? Object.keys(CUR.b || {}).length : 0,
      'abhi kitne badge banne hain': CUR ? Object.keys(CUR.d || {}).length : 0,
      'page par lage badge': document.querySelectorAll('.rt-up').length,
      'data ka version (isi par badge tike hain)': dataVer(),
      'badge jis version ke hain': (CUR && CUR.ver) || '(abhi koi nahi)',
      'chhupe hue element bhi gine ja rahe hain': true,
      'saare saved context': Object.keys(st),
      'localStorage chal raha hai': (function () {
        try { localStorage.setItem('_rt_t', '1'); localStorage.removeItem('_rt_t'); return true; }
        catch (e) { return false; }
      })()
    };
    try { console.table(items.slice(0, 15).map(function (x) {
      return { key: x.key, abhi: x.n, pichhla: (CUR && CUR.b[x.key]), text: x.txt };
    })); } catch (e) {}
    console.log(o);
    return o;
  };

  window.rtDeltaRescan = function () { CTX = null; SEEN = {}; schedule(true); };
  window.rtDeltaReset = function () {
    try { localStorage.removeItem(STORE); } catch (e) { }
    CTX = null; CUR = null; SEEN = {}; clearBadges();
  };
})();
</script>

<script>
/* ===== TWEET INTELLIGENCE (merge v1) =====
   'Trending' aur 'Tweet Explorer' ab do alag sidebar item nahi hain -- dono
   ek hi 'Tweet Intelligence' page ke andar sub-tab hain.

   Dono ka poora purana HTML/JS jaisa tha waisa hi hai (filter, chip, date,
   party, sort, search, card, Open link -- sab). Sirf unhe ek section ke andar
   rakh diya gaya hai. Data bhi wahi ek API deti hai (/api/tw/*), isliye do
   jagah se ek hi cheez do baar nahi mangwate.

   Purane naam bhi chalte rehte hain: switchTab('trending') / ('explorer')
   ab is page ko khol kar sahi sub-tab par le jaate hain -- taaki koi purana
   link, button ya AI assistant ka jump toote nahi. */
(function () {
  'use strict';
  var cur = 'trending', loaded = {};

  function pane(name) {
    if (name !== 'trending' && name !== 'explorer') name = cur || 'trending';
    cur = name;
    var ps = document.querySelectorAll('#sec-tweets .ti-pane');
    Array.prototype.forEach.call(ps, function (p) {
      p.classList.toggle('on', p.id === 'ti-' + name);
    });
    var bs = document.querySelectorAll('#sec-tweets .ti-tab');
    Array.prototype.forEach.call(bs, function (b) {
      b.classList.toggle('on', b.dataset.p === name);
    });
    /* Data pehli baar khulne par hi -- dono ek saath maangna bekaar hai. */
    try {
      if (name === 'trending' && !loaded.tr) { loaded.tr = 1; window.ntTrend && window.ntTrend(); }
      if (name === 'explorer' && !loaded.ex) { loaded.ex = 1; window.ntExplore && window.ntExplore(true); }
    } catch (e) { console.warn('[tweet-intel]', e); }
  }
  window.tiPane = pane;

  function boot() {
    var bar = document.querySelector('#sec-tweets .ti-tabs');
    if (bar) bar.addEventListener('click', function (e) {
      var b = e.target.closest('.ti-tab'); if (!b) return;
      pane(b.dataset.p);
    });

    var orig = window.switchTab;
    if (typeof orig !== 'function') return;
    window.switchTab = function (name) {
      if (name === 'trending' || name === 'explorer') {
        var r = orig.call(this, 'tweets');
        pane(name);
        return r;
      }
      var out = orig.apply(this, arguments);
      if (name === 'tweets') pane(cur);
      return out;
    };
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else setTimeout(boot, 0);
})();
</script>


<script>
/* ---------- LAST UPDATED (upd v2) ----------
   "Data kab update hua" -- header pill, har table ka aakhri column, aur
   breaking-news card ke andar. Sab angrezi me.

   Time /api/version se: meta.lastUpdate, jo pipeline har push ke baad
   likhta hai (push_all_scopes.py ka _stamp). All India = india_Pulse,
   UP = up_pulse, isliye scope URL se pakadte hain.

   Ye module sirf text likhta hai -- kisi maujooda cheez ko chhedta nahi.
   Sab try/catch me hai, page kabhi nahi tootega. */
(function () {
  'use strict';
  var LAST = null;

  function scopeOf() {
    try {
      var m = location.search.match(/[?&]scope=(up|all)\b/);
      if (m) return m[1];
      if (/^\/up(\/|$)/.test(location.pathname)) return 'up';
    } catch (e) {}
    return 'all';
  }

  /* "2026-10-01 07:26:13" -> Date (local) */
  function parseTs(v) {
    if (!v) return null;
    var d = new Date(String(v).trim().replace(' ', 'T'));
    return isNaN(d.getTime()) ? null : d;
  }

  function ago(d) {
    if (!d) return '\u2014';
    var sec = Math.floor((Date.now() - d.getTime()) / 1000);
    if (sec < 0) sec = 0;
    if (sec < 45) return 'just now';
    var min = Math.round(sec / 60);
    if (min < 60) return min === 1 ? '1 min ago' : min + ' min ago';
    var hr = Math.floor(min / 60);
    if (hr < 24) return hr === 1 ? '1 hour ago' : hr + ' hours ago';
    var day = Math.floor(hr / 24);
    return day === 1 ? '1 day ago' : day + ' days ago';
  }

  function tip(d) {
    try { return d ? ('Data last updated: ' + d.toLocaleString('en-IN')) : 'Not known yet'; }
    catch (e) { return ''; }
  }

  function fill(sel, txt, t) {
    try {
      var e = document.querySelectorAll(sel);
      for (var i = 0; i < e.length; i++) { e[i].textContent = txt; e[i].title = t; }
    } catch (e2) {}
  }

  function render() {
    var txt = ago(LAST), t = tip(LAST);
    try {
      var p = document.getElementById('updPill');
      if (p) { p.textContent = '\u21BB ' + txt; p.title = t; }
    } catch (e) {}
    fill('.lu-td', txt, t);
    fill('.bn-upd', '\u21BB updated ' + txt, t);
  }

  /* har table me aakhri column "LAST UPDATED".
     Idempotent hai -- pehle se laga ho to kuch nahi karta. */
  function addCol() {
    try {
      var ts = document.querySelectorAll('.tbl-box table');
      for (var i = 0; i < ts.length; i++) {
        var t = ts[i], th = t.tHead;
        if (!th || !th.rows.length) continue;
        var hr = th.rows[th.rows.length - 1];
        if (!hr.querySelector('.lu-th')) {
          var c = document.createElement('th');
          c.className = 'lu-th';
          c.textContent = 'LAST UPDATED';
          hr.appendChild(c);
        }
        var cols = hr.cells.length;
        for (var b = 0; b < t.tBodies.length; b++) {
          var rows = t.tBodies[b].rows;
          for (var r = 0; r < rows.length; r++) {
            var row = rows[r];
            /* "kuch nahi mila" wali ek-cell row -- usko sirf chaura kar do */
            if (row.cells.length === 1 && row.cells[0].colSpan > 1) {
              row.cells[0].colSpan = cols;
              continue;
            }
            if (!row.querySelector('.lu-td')) {
              var td = document.createElement('td');
              td.className = 'lu-td';
              td.textContent = '\u2014';
              row.appendChild(td);
            }
          }
        }
      }
    } catch (e) {}
  }

  function poll() {
    try {
      fetch('/api/version?scope=' + scopeOf(), { cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          /* rt-fix v5 : live indicator isi version par tika hai --
             badge tab tak rehte hain jab tak ye nahi badalta. */
          try { window.IPP_DATA_VER = (j && j.v) ? String(j.v) : ''; } catch (e) {}
          var d = parseTs(j && j.v);
          if (!d) {
            return fetch('/api/version', { cache: 'no-store' })
              .then(function (r2) { return r2.json(); })
              .then(function (j2) { LAST = parseTs(j2 && j2.v); render(); });
          }
          LAST = d; render();
        })
        .catch(function () {});
    } catch (e) {}
  }

  /* table filter badalne par rows dobara banti hain -- tab column wapas lagao */
  var pending = null;
  function watch() {
    try {
      var mo = new MutationObserver(function () {
        if (pending) return;
        pending = setTimeout(function () { pending = null; addCol(); render(); }, 150);
      });
      mo.observe(document.body, { childList: true, subtree: true });
    } catch (e) {}
  }

  function boot() {
    addCol(); render(); poll(); watch();
    setInterval(poll, 60000);
    setInterval(function () { addCol(); render(); }, 20000);
    try {
      var orig = window.switchTab;
      if (typeof orig === 'function') {
        window.switchTab = function () {
          var out = orig.apply(this, arguments);
          setTimeout(function () { addCol(); render(); }, 60);
          return out;
        };
      }
    } catch (e) {}
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else setTimeout(boot, 0);
})();
</script>

<script>
/* ---------- HANDLE ANALYTICS (ha v2) ----------
   Layout wahi jo aapne diya tha: upar controls, phir bada profile banner
   (cover + avatar), phir alag-alag section card -- Growth Trends, Content
   Performance, Engagement Rate, Daily Breakdown, Latest Tweets.

   Data MONGO se, 4 route se:
     /api/ha/cats  /api/ha/handles  /api/ha/analytics  /api/ha/tweets
   Photo/cover/bio: handle click karte hi server X se LIVE utha kar
   pulse_master.x_profiles me save kar deta hai (7 din purani ho to dobara).
   Banner ka refresh button (/api/ha/profile?fresh=1) jabardasti abhi uthata hai.
   Na aaye to initials dikhte hain aur neeche ek line asli wajah batati hai. */
(function () {
  'use strict';
  var CUR = null, OFFSET = 0, PAGE = 20, LIST = [], LOADING = false;

  function el(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s === null || s === undefined ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function nf(n) { return (Math.round(Number(n) || 0)).toLocaleString('en-IN'); }
  function big(n) { try { return window.fmt ? window.fmt(n) : nf(n); } catch (e) { return nf(n); } }
  function col(p) { try { return window.pc ? window.pc(p) : '#E65100'; } catch (e) { return '#E65100'; } }
  /* avg-fix front : null/undefined ko "--", baaki normal */
  function bigN(n) { return (n === null || n === undefined) ? '\u2014' : big(n); }
  function ini(s) {
    var w = String(s || '').trim().split(/\s+/).filter(Boolean);
    if (!w.length) return '?';
    return (w[0][0] + (w.length > 1 ? w[w.length - 1][0] : '')).toUpperCase();
  }
  function scope() {
    try { if (/^\/up(\/|$)/.test(location.pathname)) return 'up'; } catch (e) {}
    return 'all';
  }
  function api(path, q) {
    var u = path + '?scope=' + scope();
    for (var k in q) if (q[k] !== undefined && q[k] !== null && q[k] !== '')
      u += '&' + k + '=' + encodeURIComponent(q[k]);
    return fetch(u, { cache: 'no-store' }).then(function (r) {
      var ct = r.headers.get('content-type') || '';
      if (ct.indexOf('json') < 0)
        throw new Error('Server ne JSON nahi bheja (HTTP ' + r.status + '). START_LIVE.bat dobara chalao.');
      return r.json();
    }).then(function (j) { if (j && j.error) throw new Error(j.error); return j; });
  }

  function loadCats() {
    return api('/api/ha/cats').then(function (list) {
      var s = el('haCat'); if (!s) return;
      s.innerHTML = '<option value="ALL">All categories</option>'
        + (list || []).map(function (c) {
            return '<option value="' + esc(c.cat) + '">' + esc(c.cat) + ' (' + nf(c.n) + ')</option>';
          }).join('');
    });
  }

  window.haLoadHandles = function () {
    var sel = el('haSel'); if (!sel) return;
    sel.innerHTML = '<option value="">Loading…</option>';
    var cat = (el('haCat') || {}).value || 'ALL';
    var q = ((el('haQ') || {}).value || '').trim();
    return api('/api/ha/handles', { cat: cat, q: q }).then(function (list) {
      LIST = list || [];
      if (!LIST.length) { sel.innerHTML = '<option value="">No matches</option>'; return; }
      sel.innerHTML = LIST.map(function (o) {
        return '<option value="' + esc(o.h) + '">' + esc(o.name || o.h) + '  (@' + esc(o.h) + ')</option>';
      }).join('');
      var keep = LIST.some(function (o) { return o.h === CUR; });
      sel.value = keep ? CUR : LIST[0].h;
      window.haPickSel();
    }).catch(function (e) {
      sel.innerHTML = '<option value="">' + esc(e.message) + '</option>';
    });
  };

  var tS = null;
  window.haSearch = function () { clearTimeout(tS); tS = setTimeout(window.haLoadHandles, 300); };
  window.haPickSel = function () {
    var v = (el('haSel') || {}).value || '';
    if (!v || v === CUR) { if (v && !CUR) { CUR = v; window.haReload(); } return; }
    CUR = v; OFFSET = 0; window.haReload();
  };

  window.haReload = function () {
    if (!CUR || LOADING) return;
    LOADING = true;
    var days = (el('haPeriod') || {}).value || 'all';
    api('/api/ha/analytics', { h: CUR, days: days }).then(function (r) {
      LOADING = false; render(r); OFFSET = 0; loadTweets();
    }).catch(function (e) {
      LOADING = false;
      var n = el('haNote'); if (n) { n.className = 'ha-note on'; n.textContent = e.message; }
    });
  };

  /* ---- xlive-front : profile alag se bharte hain ----------------
     render() aur refresh button dono yahi bulate hain, taaki refresh par
     poora analytics dobara na khinche. */
  var PROF = null;

  function agoEn(iso) {
    var t = iso ? Date.parse(iso) : NaN;
    if (!t) return '';
    var s = Math.max(0, (Date.now() - t) / 1000);
    if (s < 90) return 'just now';
    var m = Math.round(s / 60); if (m < 60) return m + ' min ago';
    var h = Math.round(m / 60); if (h < 24) return h + (h === 1 ? ' hour ago' : ' hours ago');
    var d = Math.round(h / 24); return d + (d === 1 ? ' day ago' : ' days ago');
  }

  function fillProfile(p, c) {
    var b = el('haBanner'), cv = el('haCover'), av = el('haAv');
    if (!b) return;
    b.classList.remove('has-cover');
    b.style.background = 'linear-gradient(135deg,' + c + ',#FFC266)';
    if (p.cover) {
      var probe = new Image();
      b.dataset.cover = p.cover;
      probe.onload = function () {
        if (b.dataset.cover !== p.cover) return;      // beech me handle badal gaya
        cv.style.backgroundImage = 'url("' + p.cover + '")';
        b.classList.add('has-cover');
        b.style.background = c;
      };
      probe.src = p.cover;
    } else { b.dataset.cover = ''; cv.style.backgroundImage = ''; }

    if (p.image) {
      av.style.backgroundImage = 'url("' + p.image + '")';
      av.textContent = '';
    } else {
      av.style.backgroundImage = '';
      av.textContent = ini(p.name);
    }
    el('haName').textContent = p.name || ('@' + p.h);

    /* @handle + kab uthi thi */
    var ago = agoEn(p.fetchedAt);
    el('haHandle').innerHTML = '@' + esc(p.h)
      + (ago ? '<span class="ha-live' + (p.live ? '' : ' old') + '">'
               + (p.live ? 'LIVE &middot; ' : 'X &middot; ') + esc(ago) + '</span>' : '');

    el('haChips').innerHTML = [p.party, p.cat, p.state].filter(Boolean)
      .map(function (x) { return '<span>' + esc(x) + '</span>'; }).join('');
    el('haBio').textContent = p.bio || '';
  }

  /* kyun nahi aayi -- seedha English/Hinglish me */
  function profWhy(p) {
    if (p.image || p.cover) return '';
    if (p.canLive === false)
      return 'Photo / cover ke liye DASHBOARD folder me x_config.json banao aur usme apne X ke 3 cookie '
           + '(auth_token, ct0, twid) bhar do — phir handle click karne par apne aap aa jaayegi.';
    if (p.why === 'RATE')
      return 'X ne abhi rate-limit laga diya hai. 15 minute baad refresh (↻) dabao.';
    if (p.why === 'AUTH')
      return 'X ne cookie reject kar di (login expire). x_config.json me naye auth_token / ct0 / twid daalo.';
    if (p.why === 'NOTFOUND')
      return 'Ye handle X par nahi mila (naam badal gaya ya account band ho gaya).';
    if (p.why === 'COOLDOWN')
      return 'Abhi isi handle ki koshish fail hui thi — 10 minute baad refresh (↻) dabao.';
    if (p.why && p.why !== 'CACHE' && p.why !== 'LIVE')
      return 'X se profile nahi aayi (' + p.why + '). Refresh (↻) dabake dobara dekho.';
    return '';
  }

  /* banner ka refresh button */
  window.haRefreshProf = function () {
    if (!CUR) return;
    var btn = el('haRefresh');
    if (btn) { btn.classList.add('spin'); btn.disabled = true; }
    api('/api/ha/profile', { h: CUR, fresh: 1 }).then(function (p) {
      if (p && p.h === CUR) {
        var keep = PROF || {};
        p.party = keep.party; p.cat = keep.cat; p.state = keep.state;
        PROF = p;
        fillProfile(p, col(p.party));
        noteNow(p, LASTCOV);
      }
    }).catch(function (e) {
      var n = el('haNote');
      if (n) { n.className = 'ha-note on'; n.textContent = e.message; }
    }).then(function () {
      if (btn) { btn.classList.remove('spin'); btn.disabled = false; }
    });
  };

  /* note dono jagah se banti hai -- isliye alag */
  var LASTCOV = null, LASTSUM = null;   /* er-fix v2 */
  function noteNow(p, cov) {
    cov = cov || {};
    var miss = [], note = [];
    if (cov.rows) {
      if (!cov.likes) miss.push('Likes');
      if (!cov.comments) miss.push('Comments');
      if (!cov.views) miss.push('Views');
      if (!cov.shares) miss.push('Shares');
    }
    if (miss.length)
      note.push('Is handle ke ' + nf(cov.rows) + ' tweets me ' + miss.join(' / ')
        + ' ka data database me hai hi nahi — isliye wahan "—" dikh raha hai.');
    /* avg-fix front : aadha-adhoora data bhi batao.
       Pehle note sirf tab aati thi jab column BILKUL khaali ho. Par asli
       dikkat aadhe-adhoore data me hai -- jaise 1,036 tweets me se sirf
       194 me Likes. Aausat ab un 194 par hi banta hai (sahi), par ye
       batana zaroori hai ki wo kitne tweets ka hai. */
    if (cov.rows) {
      var part = [];
      [['likes','Likes'],['comments','Comments'],['views','Views'],['shares','Shares']]
        .forEach(function (p) {
          var c = cov[p[0]] || 0;
          if (c > 0 && c < cov.rows * 0.9)
            part.push(p[1] + ' ' + nf(c) + '/' + nf(cov.rows));
        });
      if (part.length)
        note.push('Kuch column sirf kuch hi tweets me bhare hain — ' + part.join(', ')
          + '. Aausat sirf unhi tweets par bana hai jinme wo data hai '
          + '(warna aausat patla ho kar 0 dikhne lagta tha).');
    }
    /* no-sharewarn : Shares-vs-Views wali warning dashboard se hata di.
       Engagement Rate pehle hi hat chuka hai, isliye ye line screen par bas
       shor thi. Hisaab waise ka waisa hai -- ha_lib.js abhi bhi erBad /
       erCulprit bhejta hai, bas dikhta nahi. Kabhi dobara chahiye to neeche
       wali line se comment hata dena, aur browser console me ye chalao:
           haDebugData()   ->  kis column me kitni gadbad hai
    if (LASTSUM && LASTSUM.erBad > 0 && LASTSUM.erCulprit)
      note.push(nf(LASTSUM.erBad) + ' tweets me ' + LASTSUM.erCulprit + ' > Views');
    */
    window.haDebugData = function () {
      var d = LASTSUM || {};
      console.log({
        'tweets jinka data toota hai': d.erBad,
        'kaun sa column': d.erCulprit,
        'tweets jinke Views hain': d.erRows,
        'tweets jinke Views nahi': d.erMiss,
        'har column me kitni row bhari hai': d.coverage
      });
      return d;
    };
    var w = profWhy(p);
    if (w) note.push(w);
    var nEl = el('haNote');
    if (!nEl) return;
    nEl.innerHTML = note.map(function (t) { return esc(t); }).join('<br>');
    nEl.className = note.length ? 'ha-note on' : 'ha-note';
  }

  function render(r) {
    var p = r.profile, s = r.summary, d = r.daily || [], c = col(p.party);

    /* ---- banner + profile  (xlive-front) ---- */
    PROF = p;
    fillProfile(p, c);

    /* ---- stat cells  (no-er : Engagement Rate tile hata di) ---- */
    var cells = [
      [big(p.xFollowers || s.followers), 'Followers'],
      [big(p.xFollowing || s.following), 'Following'],
      [big(p.xPosts || s.totalPosts), 'Total Posts'], [s.postsPerDay, 'Posts / Day'],
      /* avg-fix front : jis column ka data hi nahi aaya, uspar "0" ke
         bajaye "--". 0 ka matlab hota hai "sach me zero", aur wo galat
         sandesh tha -- data hai hi nahi. */
      [bigN(s.avgLikes), 'Avg Likes'], [bigN(s.avgComments), 'Avg Comments'],
      [bigN(s.avgViews), 'Avg Views'], [bigN(s.avgShares), 'Avg Shares'],
      [big(s.totalEngagement), 'Total Engagement']
    ];
    /* kpi-tiles : har tile ka left-bar party colour ka */
    el('haCells').innerHTML = cells.map(function (x) {
      return '<div class="c" style="--accent:' + c + '"><div class="v">'
        + esc(String(x[0])) + '</div><div class="l">' + x[1] + '</div></div>';
    }).join('');

    /* ---- neeche ki note  (xlive-front) ---- */
    LASTCOV = s.coverage || {};
    LASTSUM = s;                      /* er-fix v2 */
    noteNow(p, LASTCOV);

    /* ---- top tweet ---- */
    var t = r.topTweet, tc = el('haTopCard');
    if (t) {
      tc.style.display = '';
      el('haTopText').textContent = t.text || '';
      el('haTopStats').innerHTML =
        '<span>Likes <b>' + big(t.likes) + '</b></span>'
        + '<span>Comments <b>' + big(t.comments) + '</b></span>'
        + '<span>Views <b>' + big(t.views) + '</b></span>'
        + '<span>Shares <b>' + big(t.shares) + '</b></span>'
        + (t.url ? '<a style="margin-left:auto;color:' + c + ';font-weight:700;text-decoration:none" href="'
            + esc(t.url) + '" target="_blank" rel="noopener">Open ↗</a>' : '');
    } else { tc.style.display = 'none'; }

    /* ---- charts ---- */
    var L = d.map(function (x) { return x.date; });
    el('haGrowth').innerHTML =
        chart('Followers', L, d.map(function (x) { return x.followers; }), '#E65100', true, big(s.followers))
      + chart('Following', L, d.map(function (x) { return x.following; }), '#B45309', true, big(s.following));
    el('haContent').innerHTML =
        chart('Posts / Day', L, d.map(function (x) { return x.posts; }), '#1B5E20', false, s.postsPerDay + '<small>avg/day</small>')
      + chart('Likes / Day', L, d.map(function (x) { return x.likes; }), '#C62828', false, big(s.avgLikes) + '<small>avg</small>')
      + chart('Comments / Day', L, d.map(function (x) { return x.comments; }), '#A8611F', false, big(s.avgComments) + '<small>avg</small>')
      + chart('Views / Day', L, d.map(function (x) { return x.views; }), '#4A148C', false, big(s.avgViews) + '<small>avg</small>')
      + chart('Shares / Day', L, d.map(function (x) { return x.shares; }), '#0D47A1', false, big(s.avgShares) + '<small>avg</small>');
    /* no-er : Engagement Rate chart hata diya gaya */

    /* ---- daily breakdown -- sirf pichhle 7 din  (kpi-tiles) ---- */
    var d7 = d.slice(-7);                       // aakhri 7 din
    var lbl = el('haDailyNote');
    if (lbl) lbl.textContent = d7.length ? ('Last ' + d7.length
      + (d7.length === 1 ? ' day' : ' days') + (d.length > d7.length
        ? '  ·  ' + d.length + ' days in charts above' : '')) : '';
    el('haDaily').innerHTML = d7.length ? d7.slice().reverse().map(function (x) {
      return '<tr><td>' + esc(x.date) + '</td><td class="r">' + nf(x.posts) + '</td>'
        + '<td class="r">' + (x.followers === null ? '—' : big(x.followers)) + '</td>'
        + '<td class="r">' + (x.following === null ? '—' : big(x.following)) + '</td>'
        + '<td class="r">' + big(x.likes) + '</td><td class="r">' + big(x.comments) + '</td>'
        + '<td class="r">' + big(x.views) + '</td><td class="r">' + big(x.shares) + '</td>'
        + '<td class="r">' + big(x.engagement) + '</td></tr>';
    }).join('') : '<tr><td colspan="9" class="ha-empty">Is period me data nahi.</td></tr>';
  }

  function chart(label, labels, data, c, zoom, bottom) {
    var real = data.filter(function (v) { return v !== null && v !== undefined; }).map(Number);
    if (!real.length) {
      return '<div class="ha-chart"><div class="ha-ct">' + label + '</div>'
        + '<div class="ha-cempty">Abhi data nahi</div></div>';
    }
    var W = 320, H = 110, pL = 6, pR = 6, pT = 6, pB = 16;
    var pw = W - pL - pR, ph = H - pT - pB, mn, mx;
    if (zoom) {
      mx = Math.max.apply(null, real); mn = Math.min.apply(null, real);
      if (mn === mx) { mn -= 1; mx += 1; }
      var pad = (mx - mn) * 0.08; mn -= pad; mx += pad;
    } else {
      var nums = data.map(function (v) { return Number(v) || 0; });
      mx = Math.max.apply(null, nums); mn = Math.min(0, Math.min.apply(null, nums));
    }
    var range = (mx - mn) || 1;
    var vals = data.map(function (v) { return (v === null || v === undefined) ? mn : Number(v); });
    var stepX = vals.length > 1 ? pw / (vals.length - 1) : 0;
    var pts = vals.map(function (v, i) { return [pL + i * stepX, pT + ph - ((v - mn) / range) * ph]; });
    var line = pts.map(function (p, i) { return (i ? 'L' : 'M') + p[0].toFixed(1) + ',' + p[1].toFixed(1); }).join(' ');
    var area = line + ' L' + pts[pts.length - 1][0].toFixed(1) + ',' + (pT + ph)
             + ' L' + pts[0][0].toFixed(1) + ',' + (pT + ph) + ' Z';
    var grid = [0, 0.5, 1].map(function (f) {
      var y = pT + ph * f;
      return '<line x1="' + pL + '" y1="' + y + '" x2="' + (W - pR) + '" y2="' + y + '" stroke="#ece9e0" stroke-width="1"/>';
    }).join('');
    var last = vals.length - 1, mid = Math.floor(last / 2);
    var xs = [0, mid, last].filter(function (v, i, a) { return a.indexOf(v) === i; }).map(function (i) {
      return '<text x="' + pts[i][0].toFixed(1) + '" y="' + (H - 3) + '" font-size="8" fill="#8a7d6d" text-anchor="middle">'
        + esc(String(labels[i] || '').slice(5)) + '</text>';
    }).join('');
    var gid = 'hag' + Math.random().toString(36).slice(2, 8);
    return '<div class="ha-chart"><div class="ha-ct">' + label + '</div>'
      + '<svg viewBox="0 0 ' + W + ' ' + H + '" width="100%" height="' + H + '" preserveAspectRatio="none">'
      + '<defs><linearGradient id="' + gid + '" x1="0" y1="0" x2="0" y2="1">'
      + '<stop offset="0%" stop-color="' + c + '" stop-opacity=".25"/>'
      + '<stop offset="100%" stop-color="' + c + '" stop-opacity="0"/></linearGradient></defs>'
      + grid + '<path d="' + area + '" fill="url(#' + gid + ')"/>'
      + '<path d="' + line + '" fill="none" stroke="' + c + '" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>'
      + xs + '</svg>'
      + (bottom ? '<div class="ha-cb">' + bottom + '</div>' : '') + '</div>';
  }

  function loadTweets() {
    if (!CUR) return;
    api('/api/ha/tweets', { h: CUR, offset: OFFSET, limit: PAGE }).then(function (r) {
      var b = el('haTwBody'); if (!b) return;
      var list = r.items || [];
      b.innerHTML = list.length ? list.map(function (t) {
        return '<tr><td><span class="ha-tt" title="' + esc(t.text) + '">' + esc(t.text) + '</span></td>'
          + '<td style="font-size:10.5px;white-space:nowrap">' + esc(String(t.date).slice(0, 16)) + '</td>'
          + '<td class="r">' + big(t.likes) + '</td><td class="r">' + big(t.comments) + '</td>'
          + '<td class="r">' + big(t.views) + '</td><td class="r">' + big(t.shares) + '</td>'
          + '<td style="font-size:10.5px">' + esc(t.sent || '—') + '</td>'
          + '<td>' + (t.url ? '<a style="color:#E65100;font-weight:600;text-decoration:none" href="' + esc(t.url)
              + '" target="_blank" rel="noopener">Open ↗</a>' : '—') + '</td></tr>';
      }).join('') : '<tr><td colspan="8" class="ha-empty">Koi tweet nahi.</td></tr>';
      var start = r.total === 0 ? 0 : r.offset + 1;
      var end = Math.min(r.offset + r.pageSize, r.total);
      var inf = el('haTwInfo'); if (inf) inf.textContent = start + '–' + end + ' of ' + nf(r.total);
      var cnt = el('haTwCount'); if (cnt) cnt.textContent = nf(r.total) + ' total';
      var pv = el('haPrev'), nx = el('haNext');
      if (pv) pv.disabled = r.offset <= 0;
      if (nx) nx.disabled = end >= r.total;
    }).catch(function (e) {
      var b = el('haTwBody');
      if (b) b.innerHTML = '<tr><td colspan="8" class="ha-empty">' + esc(e.message) + '</td></tr>';
    });
  }
  window.haPrev = function () { OFFSET = Math.max(0, OFFSET - PAGE); loadTweets(); };
  window.haNext = function () { OFFSET += PAGE; loadTweets(); };

  var booted = false;
  function boot() {
    if (booted) return; booted = true;
    loadCats().then(window.haLoadHandles).catch(function (e) {
      var n = el('haNote'); if (n) { n.className = 'ha-note on'; n.textContent = e.message; }
    });
  }
  var orig = window.switchTab;
  if (typeof orig === 'function') {
    window.switchTab = function (name) {
      var out = orig.apply(this, arguments);
      if (name === 'handle-analytics') boot();
      return out;
    };
  }
})();
</script>
<script>
/* ================= Handles To Be Added ================= */
(function(){
  var ROWS=null, CHECKED=null;

  function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function api(p,o){return fetch(p,o||{}).then(function(r){return r.json();});}
  function ago(v){if(!v)return '';var t=Date.parse(v);if(!t)return '';
    var s=Math.max(0,(Date.now()-t)/1000);if(s<60)return 'just now';
    var m=Math.round(s/60);if(m<60)return m+' min ago';
    var h=Math.round(m/60);if(h<24)return h+' hr ago';
    var d=Math.round(h/24);return d+(d===1?' day ago':' days ago');}

  window.hrqUpload=function(inp){
    var f=inp.files&&inp.files[0];if(!f)return;
    document.getElementById('hrqFileName').textContent=f.name;
    var box=document.getElementById('hrqCheck');
    box.innerHTML='<p class="hrq-note">Checking\u2026</p>';
    var fr=new FileReader();
    fr.onload=function(){
      fetch('/api/handle-request/check',{method:'POST',
        headers:{'Content-Type':'text/csv'},body:fr.result})
       .then(function(r){return r.json();}).then(paintCheck)
       .catch(function(e){box.innerHTML='<div class="hrq-box bad">Could not read that file: '
         +esc(String(e))+'</div>';})
       .then(function(){inp.value='';});};
    fr.onerror=function(){box.innerHTML='<div class="hrq-box bad">Could not read that file.</div>';};
    fr.readAsText(f);};

  function paintCheck(d){
    var box=document.getElementById('hrqCheck');
    var card=document.getElementById('hrqSendCard');
    if(d.error){box.innerHTML='<div class="hrq-box bad">'+esc(d.error)+'</div>';
      card.style.display='none';ROWS=null;return;}
    var rows=d.rows||[];
    if(!rows.length){box.innerHTML='<div class="hrq-box bad">No rows found in that file.</div>';
      card.style.display='none';ROWS=null;return;}

    var nNew=0,nHave=0,nBad=0;
    rows.forEach(function(r){if(r.missing&&r.missing.length)nBad++;
      else if(r.exists)nHave++;else nNew++;});

    var h='<table class="hrq-tbl"><tr><th>HANDLE</th><th>STATUS</th>'
      +'<th>WHAT WE HAVE / WHAT YOU SENT</th></tr>'
      +rows.map(function(r){
        var st,info;
        if(r.missing&&r.missing.length){
          st='<span class="hrq-bad">\u2716 Incomplete</span>';
          info='Missing: '+esc(r.missing.join(', '));
        }else if(r.exists){
          st='<span class="hrq-warn">\u25CF Already in mapping</span>';
          info='<b>In the mapping:</b> '+esc(r.have||'\u2014');
        }else{
          st='<span class="hrq-ok">\u2714 New</span>';
          info=esc(r.sent||'\u2014');
        }
        return '<tr><td><b>@'+esc(r.handle||'?')+'</b>'
          +(r.line?'<div style="color:#A89480;font-size:10.5px">CSV line '+r.line+'</div>':'')
          +'</td><td>'+st+'</td><td style="white-space:normal">'+info+'</td></tr>';}).join('')
      +'</table>';

    if(nBad){h+='<div class="hrq-box bad"><b>'+nBad+' row(s) are incomplete.</b> '
      +'Handle, Candidate Name and Category are needed on every row. '
      +'You can still send the request, but incomplete rows will be sent as they are and the '
      +'reviewer will have to fill them in.</div>';}
    if(nHave){h+='<div class="hrq-box warn"><b>'+nHave+' handle(s) are already in the mapping.</b> '
      +'They are not added again. If what we have looks wrong, say so in the note below and the '
      +'reviewer will correct it.</div>';}
    if(nNew){h+='<div class="hrq-box ok"><b>'+nNew+' new handle(s)</b> ready to request.</div>';}

    box.innerHTML=h;
    ROWS=rows;CHECKED=d;
    card.style.display='';
    document.getElementById('hrqSendMsg').textContent='';
    document.getElementById('hrqSendBtn').disabled=false;}

  window.hrqSend=function(){
    if(!ROWS||!ROWS.length)return;
    var btn=document.getElementById('hrqSendBtn'),msg=document.getElementById('hrqSendMsg');
    btn.disabled=true;msg.style.color='#8B6B55';msg.textContent='Sending\u2026';
    api('/api/handle-request/submit',{method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({rows:ROWS,
        remarks:(document.getElementById('hrqRemarks')||{}).value||''})})
     .then(function(r){
       if(!r.ok){msg.style.color='#A83224';msg.textContent=r.error||'Could not send';
         btn.disabled=false;return;}
       msg.style.color='#1B6B45';
       msg.textContent='Request sent \u2014 you will see the result below.';
       document.getElementById('hrqRemarks').value='';
       document.getElementById('hrqCheck').innerHTML='';
       document.getElementById('hrqFileName').textContent='';
       document.getElementById('hrqSendCard').style.display='none';
       ROWS=null;hrqMine();})
     .catch(function(e){msg.style.color='#A83224';msg.textContent=String(e);
       btn.disabled=false;});};

  function hrqMine(){
    var box=document.getElementById('hrqMine');if(!box)return;
    api('/api/handle-request/mine').then(function(d){
      var rs=d.requests||[];
      if(!rs.length){box.innerHTML='<p class="hrq-note">You have not sent any requests yet.</p>';return;}
      box.innerHTML=rs.map(function(r){
        var st=r.status||'pending';
        var head='<div style="display:flex;justify-content:space-between;align-items:center;'
          +'gap:10px;flex-wrap:wrap;margin-bottom:6px">'
          +'<b>'+ (r.count||0) +' handle'+((r.count===1)?'':'s')+'</b>'
          +'<span><span class="hrq-pill '+st+'">'+esc(({pending:'PENDING REVIEW',
            approved:'APPROVED',rejected:'REJECTED'})[st]||st.toUpperCase())+'</span>'
          +' <span class="hrq-note">'+ago(r.at)+'</span></span></div>';
        var body='<div class="hrq-note" style="margin:0 0 6px">'
          +esc((r.handles||[]).map(function(x){return '@'+x;}).join(', '))+'</div>';
        if(r.remarks)body+='<div class="hrq-note" style="margin:0 0 6px">'
          +'<b>Your note:</b> '+esc(r.remarks)+'</div>';
        var tail='';
        if(st==='approved')tail='<div class="hrq-box ok">'
          +'<b>\u2714 Request successfully approved.</b>'
          +(r.added?' '+r.added+' handle(s) added to the mapping.':'')
          +(r.adminNote?'<br>Reviewer: '+esc(r.adminNote):'')
          +'<br><span style="font-size:11.5px">They are tracked from the next scrape onward.</span></div>';
        else if(st==='rejected')tail='<div class="hrq-box bad"><b>\u2716 Request rejected.</b>'
          +(r.adminNote?'<br>Reason: '+esc(r.adminNote):'')+'</div>';
        else tail='<div class="hrq-box warn">Waiting for review.</div>';
        return '<div style="border:1.5px solid #F0E3D4;border-radius:11px;padding:12px 14px;'
          +'margin-bottom:10px">'+head+body+tail+'</div>';}).join('');
    }).catch(function(e){
      box.innerHTML='<p class="hrq-note">Could not load your requests: '+esc(String(e))+'</p>';});}

  window.hrqMine=hrqMine;

  /* tab khulte hi apni request list taaza karo */
  var orig=window.switchTab;
  if(typeof orig==='function'){
    window.switchTab=function(name){
      var out=orig.apply(this,arguments);
      if(name==='handle-req')hrqMine();
      return out;};}
  if(document.getElementById('sec-handle-req'))hrqMine();
})();
</script>
</body>
</html>
