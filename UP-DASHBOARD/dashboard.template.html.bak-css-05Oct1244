  function tdw(n){return '<td style="padding:6px;border:1px solid #f0e6d8;text-align:center;color:#fff;'+PCE+'">'+fmt(n)+'</td>';}
  function reportHTML(rep){
    var v=rep.volume;
    var vol=[['Total Tweets',IN(v.totalTweets)],['Retweets',fmt(v.retweets)],['Likes',fmt(v.likes)],['Unique Handle',IN(v.uniqueHandles)],['Total Views',fmt(v.totalViews)],['Overall Sentiment',v.sentiment]];
    var h='';
