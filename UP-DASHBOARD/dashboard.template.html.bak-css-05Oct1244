<script>
/* =====================================================================
   TRENDING · TWEET EXPLORER · WORD CLOUD · AI ASSISTANT
   ---------------------------------------------------------------------
   Trending aur Explorer server se live aate hain (/api/tw/*), kyunki
   16.9 lakh tweets HTML me bake nahi ho sakte.
   Word Cloud pipeline me hi gina jaata hai -> WORDCLOUD key.
   ===================================================================== */
window.WORDCLOUD = "__MONGO_WORDCLOUD__";
(function () {
  'use strict';
  var $ = function (id) { return document.getElementById(id); };
  function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
  function nf(n) { return (Math.round(+n) || 0).toLocaleString('en-IN'); }
  function scope() { return window.DASH_SCOPE === 'up' ? 'up' : 'all'; }

  /* ---------- date range ---------- */
  // AD / PHD_DATES me poori date list hoti hai (dashboard ka apna source).
  function dates() { return (window.PHD_DATES && window.PHD_DATES.length) ? window.PHD_DATES : (window.AD || []); }
  function setDates(pfx) {
    var D = dates(); if (!D.length) return;
    var f = $(pfx + 'From'), t = $(pfx + 'To');
    [f, t].forEach(function (e) { if (e) { e.min = D[0]; e.max = D[D.length - 1]; } });
    if (f && !f.value) f.value = D[0];
    if (t && !t.value) t.value = D[D.length - 1];
  }
  window.ntPreset = function (pfx) {
    var D = dates(), v = ($(pfx + 'Preset') || {}).value;
    if (v !== 'custom' && D.length) {
      var last = D[D.length - 1];
      var from = (v === 'all') ? D[0]
               : (v === 'today') ? last
               : D[Math.max(0, D.length - parseInt(v, 10))];
      if ($(pfx + 'From')) $(pfx + 'From').value = from;
      if ($(pfx + 'To')) $(pfx + 'To').value = last;
    }
    (pfx === 'tr' ? window.ntTrend : function () { window.ntExplore(true); })();
  };
  window.ntCustom = function (pfx) {
    var p = $(pfx + 'Preset'); if (p) p.value = 'custom';
    (pfx === 'tr' ? window.ntTrend : function () { window.ntExplore(true); })();
  };
  function qs(pfx) {
    var s = '?scope=' + scope();
    var f = ($(pfx + 'From') || {}).value, t = ($(pfx + 'To') || {}).value;
    if (f) s += '&from=' + f;
    if (t) s += '&to=' + t;
    var p = ($(pfx + 'Party') || {}).value;
    if (p && p !== 'all') s += '&party=' + encodeURIComponent(p);
    return s;
  }

  /* ---------- party dropdown (dashboard ke apne data se) ---------- */
  function fillParties() {
    var list = [];
    try {
      if (typeof PARTY_DATA === 'object' && PARTY_DATA) list = Object.keys(PARTY_DATA);
    } catch (e) {}
    list = list.filter(Boolean).sort();
    ['trParty', 'exParty'].forEach(function (id) {
      var sel = $(id); if (!sel || sel.dataset.done) return;
      list.forEach(function (p) {
        var o = document.createElement('option'); o.value = p; o.textContent = p; sel.appendChild(o);
      });
      sel.dataset.done = '1';
    });
  }

  /* ---------- ek tweet ka card ---------- */
  function card(r) {
    var nm = r.cn || r.h || '?';
    var sn = String(r.sn || '').toLowerCase();
    var cls = sn.indexOf('pos') === 0 ? ' pos' : (sn.indexOf('neg') === 0 ? ' neg' : '');
    return '<div class="nt-card">'
      + '<div class="nt-top">'
      +   '<div class="nt-av">' + esc(nm.charAt(0).toUpperCase()) + '</div>'
      +   '<div><div class="nt-nm">' + esc(nm) + '</div>'
      +   '<div class="nt-sub">@' + esc(r.h) + (r.dg ? ' &middot; ' + esc(r.dg) : '')
      +     (r.st ? ' &middot; ' + esc(r.st) : '') + ' &middot; ' + esc(r.d) + '</div></div>'
      +   (r.pt ? '<span class="nt-pill">' + esc(r.pt) + '</span>' : '')
      +   (r.sn ? '<span class="nt-pill' + cls + '">' + esc(r.sn) + '</span>' : '')
      + '</div>'
      + '<div class="nt-tx">' + esc(r.tx) + '</div>'
      + '<div class="nt-mt"><span>&#128065; <b>' + nf(r.vw) + '</b></span>'
      +   '<span>&#10084; <b>' + nf(r.lk) + '</b></span>'
      +   '<span>&#128257; <b>' + nf(r.rt) + '</b></span>'
      +   '<span>&#128172; <b>' + nf(r.cm) + '</b></span>'
      +   (r.u ? '<a href="' + esc(r.u) + '" target="_blank" rel="noopener">Open &#8599;</a>' : '')
      + '</div></div>';
  }
  /* Server purana ho to naye route hote hi nahi -- Express HTML bhejta hai
     aur r.json() "<!DOCTYPE" par toot jaata hai. Pehle jaanch lo. */
  function ntJson(r) {
    var ct = r.headers.get('content-type') || '';
    if (ct.indexOf('json') < 0) {
      throw new Error(r.status === 404
        ? 'Server purana chal raha hai. START_LIVE.bat band karke dobara chalao.'
        : 'Server ne JSON nahi bheja (HTTP ' + r.status + ').');
    }
    return r.json();
  }
  function fail(box, e) {
    box.innerHTML = '<div class="nt-msg">Data nahi aaya &mdash; ' + esc(e && e.message ? e.message : e)
      + '<br><small>Server chal raha hai? Login khatm to nahi hua?</small></div>';
  }


  /* ---------- BREAKING NEWS ---------- BREAKING NEWS (news v1)
     Source: /api/news -- wahi media house / journalist tweets jo pehle se
     Mongo me hain. Card ki har cheez tweet ki apni hai; kuch banaya nahi jaata.
     Trending/Explorer wale hi helpers (esc, nf, ntJson, fail, scope) use hote
     hain -- alag se koi data-fetching logic nahi likha. */
  var bnCat = 'All', bnSort = 'latest', bnSkip = 0, bnBusy = false, bnSeen = null;
  var BN_PAGE = 30;

  function bnAgo(iso) {
    var t = Date.parse(iso); if (!t) return '';
    var s = Math.max(0, (Date.now() - t) / 1000);
    if (s < 90) return Math.round(s) + ' sec ago';
    if (s < 5400) { var m = Math.round(s / 60); return m === 1 ? '1 min ago' : m + ' min ago'; }
    if (s < 172800) { var h = Math.round(s / 3600); return h === 1 ? '1 hour ago' : h + ' hours ago'; }
    var dd = Math.round(s / 86400); return dd === 1 ? '1 day ago' : dd + ' days ago';
  }

  function bnCard(r) {
    var loc = r.scope === 'up' ? 'Uttar Pradesh'
            : r.scope === 'punjab' ? 'Punjab'
            : r.scope === 'other' ? (r.st || 'State') : 'National';
    return '<div class="bn-card' + (r.breaking ? ' brk' : '') + '">'
      + '<div class="bn-hd">'
      +   (r.breaking ? '<span class="bn-badge">&#128308; BREAKING</span>' : '')
      +   '<span class="bn-cat">' + esc(r.cat) + '</span>'
      +   '<span class="bn-loc">' + esc(loc) + '</span>'
      + '</div>'
      + '<div class="bn-h">' + esc(r.head) + '</div>'
      + (r.sum ? '<div class="bn-s">' + esc(r.sum) + '</div>' : '')
      + '<div class="bn-ft">'
      +   '<span class="bn-src">' + esc(r.src || r.h) + '</span>'
      +   '<span>' + esc(r.kind) + '</span>'
      +   '<span title="' + esc(r.date) + '">' + esc(bnAgo(r.date.replace(' ', 'T'))) + '</span>'
      +   '<span class="bn-upd" title="Dashboard data refresh">&#8635; updated &mdash;</span>'
      +   '<span>&#128065; <b>' + nf(r.vw) + '</b></span>'
      +   '<span>&#10084; <b>' + nf(r.lk) + '</b></span>'
      +   '<span>&#128257; <b>' + nf(r.rt) + '</b></span>'
      +   (r.url ? '<a href="' + esc(r.url) + '" target="_blank" rel="noopener">Read full story &#8594;</a>' : '')
      + '</div></div>';
  }

  /* Freshness -- jhooth nahi bolna hai. Ye sabse nayi KHABAR ki umr hai,
     page ki nahi. Data purana hai to seedha DELAYED / STALE dikhao. */
  function bnFresh(newestIso) {
    var dot = $('bnDot'), tx = $('bnLiveTx');
    if (!dot || !tx) return;
    var t = Date.parse(newestIso || '');
    if (!t) { dot.className = 'bn-dot bad'; tx.textContent = 'NO NEWS'; return; }
    var h = (Date.now() - t) / 3600000;
    dot.className = 'bn-dot' + (h <= 3 ? '' : (h <= 24 ? ' warn' : ' bad'));
    tx.textContent = (h <= 3 ? 'LIVE' : (h <= 24 ? 'DELAYED' : 'STALE'))
      + ' · ' + bnAgo(newestIso);
  }

  function bnCatBar(counts, total) {
    var box = $('bnCats'); if (!box) return;
    var names = ['All', 'Politics', 'Government', 'Crime', 'Law & Order', 'Elections',
      'Economy', 'Business', 'Education', 'Health', 'Weather', 'Sports', 'International', 'Other'];
    box.innerHTML = names.map(function (n) {
      var c = n === 'All' ? total : (counts[n] || 0);
      if (n !== 'All' && !c) return '';           // khaali category dikhane ka fayda nahi
      return '<button class="bn-chip' + (n === bnCat ? ' on' : '') + '" data-c="' + esc(n) + '">'
        + esc(n) + '<b>' + c + '</b></button>';
    }).join('');
  }

  window.bnLoad = function (reset) {
    var box = $('bnFeed'); if (!box || bnBusy) return;
    bnBusy = true;
    if (reset) { bnSkip = 0; box.innerHTML = '<div class="nt-msg">Loading&hellip;</div>'; }
    var u = '/api/news?scope=' + scope() + '&cat=' + encodeURIComponent(bnCat)
          + '&sort=' + bnSort + '&limit=' + BN_PAGE + '&skip=' + bnSkip;
    fetch(u, { cache: 'no-store' }).then(ntJson).then(function (j) {
      bnBusy = false;
      if (j.error) throw new Error(j.error);
      bnFresh(j.newest);
      bnSeen = j.newest || bnSeen;
      var nb = $('bnNew'); if (nb) nb.classList.remove('show');
      if (bnSkip === 0) bnCatBar(j.counts || {}, j.total || 0);
      var html = (j.rows || []).map(bnCard).join('');
      if (bnSkip === 0) {
        box.innerHTML = html || '<div class="nt-msg">Is filter par koi khabar nahi mili.</div>';
      } else if (html) {
        box.insertAdjacentHTML('beforeend', html);
      }
      bnSkip += (j.rows || []).length;
      var more = $('bnMore');
      if (more) more.style.display = (bnSkip < (j.total || 0)) ? 'inline-block' : 'none';
    }).catch(function (e) { bnBusy = false; fail(box, e); });
  };

  /* "nayi khabar aa gayi" -- 60 sec par sirf ginti poochte hain (halki query),
     poori feed apne aap nahi badalti taaki padhte waqt jhatka na lage. */
  function bnPoll() {
    if (!bnSeen) return;
    fetch('/api/news/meta?scope=' + scope() + '&since=' + encodeURIComponent(bnSeen),
          { cache: 'no-store' })
      .then(ntJson).then(function (j) {
        bnFresh(j.newest);
        var b = $('bnNew'); if (!b) return;
        if (j.fresh > 0) {
          b.textContent = '🔴 ' + j.fresh + ' nayi khabrein';
          b.classList.add('show');
        }
      }).catch(function () {});
  }

  /* ---------- 1. TRENDING ---------- */
  var trMetric = 'views', trBusy = false;
  window.ntTrend = function () {
    var box = $('trFeed'); if (!box || trBusy) return;
    trBusy = true;
    box.innerHTML = '<div class="nt-msg">Loading&hellip;</div>';
    var lim = ($('trLimit') || {}).value || 30;
    fetch('/api/tw/top' + qs('tr') + '&metric=' + trMetric + '&limit=' + lim, { cache: 'no-store' })
      .then(ntJson)
      .then(function (j) {
        trBusy = false;
        if (j.error) throw new Error(j.error);
        var info = $('trInfo');
        if (info) info.textContent = j.n + ' tweets · ' + trMetric;
        box.innerHTML = j.rows && j.rows.length
          ? j.rows.map(card).join('')
          : '<div class="nt-msg">Is filter par koi tweet nahi mila.</div>';
      })
      .catch(function (e) { trBusy = false; fail(box, e); });
  };

  /* ---------- 2. TWEET EXPLORER ---------- */
  var exSkip = 0, exBusy = false;
  window.ntExplore = function (reset) {
    var box = $('exFeed'); if (!box || exBusy) return;
    exBusy = true;
    if (reset) { exSkip = 0; box.innerHTML = '<div class="nt-msg">Loading&hellip;</div>'; }
    var term = (($('exQ') || {}).value || '').trim();
    var url = '/api/tw/list' + qs('ex') + '&sort=' + (($('exSort') || {}).value || 'date')
            + '&limit=40&skip=' + exSkip + (term ? '&q=' + encodeURIComponent(term) : '');
    fetch(url, { cache: 'no-store' })
      .then(ntJson)
      .then(function (j) {
        exBusy = false;
        if (j.error) throw new Error(j.error);
        var html = (j.rows || []).map(card).join('');
        if (reset) box.innerHTML = html || '<div class="nt-msg">Kuch nahi mila.</div>';
        else box.insertAdjacentHTML('beforeend', html);
        exSkip += (j.rows || []).length;
        var info = $('exInfo');
        if (info) info.textContent = (j.n < 0 ? '?' : nf(j.n) + (j.capped ? '+' : '')) + ' tweets · ' + nf(exSkip) + ' dikhaye';
        var more = $('exMore');
        if (more) more.style.display = ((j.rows || []).length === 40) ? '' : 'none';
      })
      .catch(function (e) { exBusy = false; if (reset) fail(box, e); });
  };

  /* ---------- 3. WORD CLOUD ---------- */
  function wc() {
    var w = window.WORDCLOUD;
    return (w && typeof w === 'object') ? w : { words: [], tags: [] };
  }
  function drawCloud(el, rows, pre) {
    if (!el) return;
    if (!rows.length) { el.innerHTML = '<div class="nt-msg">Abhi data nahi &mdash; pipeline ek baar chalne do.</div>'; return; }
    var max = rows[0].c || 1, min = rows[rows.length - 1].c || 1;
    el.innerHTML = rows.slice(0, 60).map(function (r) {
      // 12px se 30px -- ginti ke hisaab se, par log scale taaki ek bada shabd baaki sab ko daba na de
      var t = (Math.log(r.c + 1) - Math.log(min + 1)) / (Math.log(max + 1) - Math.log(min + 1) || 1);
      var sz = (12 + t * 18).toFixed(1);
      var op = (0.55 + t * 0.45).toFixed(2);
      return '<span class="nt-w" style="font-size:' + sz + 'px;opacity:' + op + '" title="' + nf(r.c) + '">'
        + esc(pre + r.w) + '<span>' + nf(r.c) + '</span></span>';
    }).join('');
  }
  window.ntWcTable = function () {
    var d = wc(), body = $('wcBody'); if (!body) return;
    var q = (($('wcQ') || {}).value || '').trim().toLowerCase();
    var kind = ($('wcKind') || {}).value || 'both';
    var rows = [];
    if (kind !== 'tags') (d.words || []).forEach(function (r) { rows.push({ w: r.w, t: 'Word', c: r.c, lk: '', vw: '' }); });
    if (kind !== 'words') (d.tags || []).forEach(function (r) { rows.push({ w: r.w, t: 'Hashtag', c: r.c, lk: r.lk, vw: r.vw }); });
    if (q) rows = rows.filter(function (r) { return r.w.toLowerCase().indexOf(q) >= 0; });
    rows.sort(function (a, b) { return b.c - a.c; });
    body.innerHTML = rows.slice(0, 300).map(function (r, i) {
      return '<tr><td>' + (i + 1) + '</td><td><b>' + esc(r.w) + '</b></td><td>' + r.t + '</td>'
        + '<td class="r">' + nf(r.c) + '</td><td class="r">' + (r.lk === '' ? '&mdash;' : nf(r.lk)) + '</td>'
        + '<td class="r">' + (r.vw === '' ? '&mdash;' : nf(r.vw)) + '</td></tr>';
    }).join('') || '<tr><td colspan="6" style="text-align:center;padding:20px;color:#999">Kuch nahi mila</td></tr>';
    var info = $('wcInfo');
    if (info) info.textContent = nf(rows.length) + ' rows' + (rows.length > 300 ? ' (300 dikhaye)' : '');
    window._wcRows = rows;
  };
  window.ntWcCsv = function () {
    var rows = window._wcRows || [];
    var csv = '﻿Word,Type,Count,Likes,Views\n' + rows.map(function (r) {
      return '"' + String(r.w).replace(/"/g, '""') + '",' + r.t + ',' + r.c + ',' + (r.lk || 0) + ',' + (r.vw || 0);
    }).join('\n');
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
    a.download = 'wordcloud_' + scope() + '_' + new Date().toISOString().slice(0, 10) + '.csv';
    a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); }, 4000);
  };
  function initWc() {
    var d = wc();
    drawCloud($('wcWords'), d.words || [], '');
    drawCloud($('wcTags'), d.tags || [], '');
    window.ntWcTable();
  }

  /* ---------- 4. AI ASSISTANT ---------- */
  /* Model ko RAW TWEET nahi bheje jaate -- sirf dashboard ke apne gine hue
     aankde. Isi liye wo naya fact bana hi nahi sakta. */
  function aiStats() {
    var s = { scope: scope() === 'up' ? 'Uttar Pradesh' : 'All India' };
    try {
      var U = (typeof HANDLES !== 'undefined' && HANDLES) ? null : null;
      if (typeof PARTY_DATA === 'object' && PARTY_DATA) {
        s.parties = Object.keys(PARTY_DATA).slice(0, 8).map(function (p) {
          var v = PARTY_DATA[p] || {};
          return { party: p, tw: v.tweets, vw: v.views, lk: v.likes,
                   pos: v.pos, neg: v.neg };
        });
      }
      if (typeof DAILY_DATA === 'object' && DAILY_DATA && DAILY_DATA.length) {
        s.daily_last14 = DAILY_DATA.slice(-14).map(function (d) { return { d: d.d, tw: d.tw }; });
        s.date_from = DAILY_DATA[0].d; s.date_to = DAILY_DATA[DAILY_DATA.length - 1].d;
      }
      if (typeof HASHTAGS === 'object' && HASHTAGS) s.top_hashtags = HASHTAGS.slice(0, 8)
        .map(function (h) { return { tag: h.tag, c: h.count }; });
      var w = wc(); if (w.words && w.words.length) s.top_words = w.words.slice(0, 12);
      if (typeof STATE_DATA === 'object' && STATE_DATA) {
        s.top_states = STATE_DATA.slice().sort(function (a, b) { return b.tweets - a.tweets; })
          .slice(0, 8).map(function (r) { return { st: r.state, tw: r.tweets, vw: r.views }; });
      }
      /* AGG.S yahan MAT bhejna -- wo har state ki poori daily series hai
         (~700 KB) aur request 413 (too large) me mar jaati hai. Totals
         UNI.tot me pehle se hain, chand hi number. */
      if (typeof UNI === 'object' && UNI) {
        s.totals = UNI.tot;
        s.sentiment = UNI.sent;
        s.handles = UNI.handles;
        if (UNI.allHandles) {
          s.top_handles = UNI.allHandles.slice()
            .sort(function (a, b) { return (b.tw || 0) - (a.tw || 0); }).slice(0, 8)
            .map(function (o) { return { h: o.h, pt: o.party, tw: o.tw, vw: o.vw }; });
        }
      }
    } catch (e) {}

    /* Aakhri suraksha: payload chhota hi rehna chahiye. Kabhi koi field
       bada nikla to sabse bhaari hisse pehle giraate hain, taaki sawaal
       413 me na mare. */
    /* Groq ka free tier 8,000 token/minute deta hai. 1 token ~ 4 akshar,
       isliye payload 9 KB se neeche rakhte hain -- warna 429 aata hai. */
    var order = ['daily_last14', 'top_states', 'top_words', 'top_hashtags', 'top_handles', 'parties'];
    for (var i = 0; i < order.length && JSON.stringify(s).length > 9000; i++) delete s[order[i]];
    return s;
  }
  function aiAdd(cls, txt) {
    var b = $('aiBody'); if (!b) return null;
    var d = document.createElement('div');
    d.className = 'ai-m ' + cls; d.textContent = txt;
    b.appendChild(d); b.scrollTop = b.scrollHeight; return d;
  }
  var aiBusy = false;
  function aiAsk(q) {
    if (!q || aiBusy) return;
    aiBusy = true;
    var inp = $('aiIn'), snd = $('aiSend');
    if (inp) inp.value = '';
    if (snd) snd.disabled = true;
    aiAdd('u', q);
    var wait = aiAdd('a', 'Soch raha hoon…');
    fetch('/api/ask?scope=' + scope(), {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ question: q, stats: aiStats() })
    }).then(function (r) {
        /* Server purana chal raha ho to /api/ask hota hi nahi -- Express
           404 ka HTML page bhejta hai aur r.json() "<!DOCTYPE" par toot
           jaata hai. Isliye pehle dekh lete hain ki mila kya. */
        var ct = r.headers.get('content-type') || '';
        if (ct.indexOf('json') < 0) {
          throw new Error(r.status === 404
            ? 'Server purana chal raha hai (/api/ask nahi mila). START_LIVE.bat band karke dobara chalao.'
            : 'Server ne JSON nahi bheja (HTTP ' + r.status + ').');
        }
        return r.json();
      })
      .then(function (j) {
        aiBusy = false; if (snd) snd.disabled = false;
        if (wait) wait.remove();
        if (j.error) aiAdd('e', j.error);
        else aiAdd('a', j.answer || 'Koi jawaab nahi mila.');
      })
      .catch(function (e) {
        aiBusy = false; if (snd) snd.disabled = false;
        if (wait) wait.remove();
        aiAdd('e', 'Nahi ho paya: ' + e.message);
      });
  }
  function initAi() {
    var fab = $('aiFab'), panel = $('aiPanel');
    if (!fab || !panel) return;
    fab.onclick = function () {
      panel.classList.toggle('open');
      if (panel.classList.contains('open')) {
        if (!$('aiBody').childElementCount) {
          aiAdd('a', 'Namaste! Main is dashboard ke aankdon par sawaal ka jawaab de sakta hoon. '
            + 'Neeche ke sujhav dabao ya khud likho.');
        }
        setTimeout(function () { var i = $('aiIn'); if (i) i.focus(); }, 120);
      }
    };
    if ($('aiClose')) $('aiClose').onclick = function () { panel.classList.remove('open'); };
    if ($('aiSend')) $('aiSend').onclick = function () { aiAsk((($('aiIn') || {}).value || '').trim()); };
    if ($('aiIn')) $('aiIn').addEventListener('keydown', function (e) {
      if (e.key === 'Enter') aiAsk(this.value.trim());
    });
    if ($('aiSug')) $('aiSug').addEventListener('click', function (e) {
      if (e.target.tagName === 'BUTTON') aiAsk(e.target.textContent);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') panel.classList.remove('open');
    });
  }

  /* ---------- boot ---------- */
  function boot() {
    fillParties();
    ['tr', 'ex'].forEach(setDates);
    var tabs = $('trTabs');
    if (tabs) tabs.addEventListener('click', function (e) {
      var b = e.target.closest('.nt-chip'); if (!b) return;
      Array.prototype.forEach.call(tabs.children, function (x) { x.classList.remove('on'); });
      b.classList.add('on'); trMetric = b.dataset.m; window.ntTrend();
    });
    var q = $('exQ');
    if (q) q.addEventListener('keydown', function (e) { if (e.key === 'Enter') window.ntExplore(true); });
    /* ---- Breaking News ---- */
    var bnc = $('bnCats');
    if (bnc) bnc.addEventListener('click', function (e) {
      var b = e.target.closest('.bn-chip'); if (!b) return;
      bnCat = b.dataset.c; window.bnLoad(true);
    });
    var bns = document.querySelectorAll('#sec-breaking .bn-bar .bn-chip[data-s]');
    Array.prototype.forEach.call(bns, function (b) {
      b.addEventListener('click', function () {
        Array.prototype.forEach.call(bns, function (x) { x.classList.remove('on'); });
        b.classList.add('on'); bnSort = b.dataset.s; window.bnLoad(true);
      });
    });
    var bnm = $('bnMore'); if (bnm) bnm.addEventListener('click', function () { window.bnLoad(false); });
    var bnn = $('bnNew'); if (bnn) bnn.addEventListener('click', function () { window.bnLoad(true); });
    setInterval(bnPoll, 60000);

    initWc();
    initAi();

    /* Tab khulne par hi data laate hain -- teeno ko ek saath load karna
       server par bekaar ka bojh hai. switchTab dashboard ka apna hai,
       usme lipat kar (wrap) kaam nikal lete hain. */
    var loaded = {};
    var orig = window.switchTab;
    if (typeof orig === 'function') {
      window.switchTab = function (name) {
        var r = orig.apply(this, arguments);
        try {
          if (name === 'trending' && !loaded.tr) { loaded.tr = 1; window.ntTrend(); }
          if (name === 'explorer' && !loaded.ex) { loaded.ex = 1; window.ntExplore(true); }
          if (name === 'breaking' && !loaded.bn) { loaded.bn = 1; window.bnLoad(true); }
        } catch (e) { console.warn('[newtabs]', e); }
        return r;
      };
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else setTimeout(boot, 0);
})();
</script>

<script>window.RP_TWEETS="__RP_TWEETS__";window.RP_RANGE="__RP_RANGE__";</script>
<script>
(function(){
  var LAST=null;
  // T = offline baked tweets (compact rows: [0]h [1]party [2]level [3]sent [4]lk [5]rt [6]vw [7]followers [8]text). null = live server par /api/report.
  var T=(window.RP_TWEETS&&typeof window.RP_TWEETS!=='string'&&window.RP_TWEETS.length)?window.RP_TWEETS:null;
  var RANGE=(typeof window.RP_RANGE==='string'&&window.RP_RANGE.indexOf('__')<0)?window.RP_RANGE:'';
  function sentLabel(pos,neu,neg){var tot=pos+neu+neg||1,pp=pos/tot,np=neg/tot;if(pp>=0.15&&pp>np*1.5)return 'Positive';if(np>=0.15&&np>pp*1.5)return 'Negative';if(pos>0&&neg>0&&Math.min(pp,np)>=0.10)return 'Mixed';return 'Neutral';}
  function clientAgg(kws,topic){
    kws=kws.map(function(k){return String(k).trim().toLowerCase().replace(/^#/,'');}).filter(Boolean);
    var users={},rt=0,lk=0,pos=0,neu=0,neg=0,P={},matched=0,vwT=0,hInfo={},tagCount={},dMin=null,dMax=null;
    for(var i=0;i<T.length;i++){var r=T[i],tx=String(r[8]||'').toLowerCase(),ok=false;
      for(var j=0;j<kws.length;j++){if(tx.indexOf(kws[j])>=0){ok=true;break;}}
      if(!ok)continue; matched++;
      var h=r[0],party=(r[1]&&(''+r[1]).trim())||'—',lv=r[2],s=String(r[3]||'').toLowerCase().slice(0,3);
      users[h]=1;rt+=r[5]||0;lk+=r[4]||0;vwT+=r[6]||0;
      var _hi=hInfo[h]||(hInfo[h]={h:h,party:r[1]||'',count:0});_hi.count++;
      var _dt=String(r[9]||'').slice(0,10);if(_dt){if(!dMin||_dt<dMin)dMin=_dt;if(!dMax||_dt>dMax)dMax=_dt;}
      var _mm=String(r[8]||'').match(/#[^\s#.,!?;:()\[\]"'…]+/g);if(_mm)for(var _q=0;_q<_mm.length;_q++){var _tg=_mm[_q].toLowerCase();if(_tg.length>1)tagCount[_tg]=(tagCount[_tg]||0)+1;}
      var sp=(s==='pos'),sn=(s==='neg');if(sp)pos++;else if(sn)neg++;else neu++;
      var pr=P[party]||(P[party]={party:party,cm:0,dcm:0,mp:0,mla:0,total:0,rt:0,likes:0,pos:0,neu:0,neg:0,top:null,topv:-1});
      if(lv==='cm'||lv==='dcm'||lv==='mp'||lv==='mla')pr[lv]++;
      pr.total++;pr.rt+=r[5]||0;pr.likes+=r[4]||0;if(sp)pr.pos++;else if(sn)pr.neg++;else pr.neu++;
      if((r[6]||0)>pr.topv){pr.topv=r[6]||0;pr.top=r;}
    }
    var handles=Object.keys(hInfo).map(function(k){return hInfo[k];}).sort(function(a,b){return b.count-a.count;});
    var hashtags=Object.keys(tagCount).map(function(k){return {tag:k,count:tagCount[k]};}).sort(function(a,b){return b.count-a.count;});
    var _MO=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    function _fd(x){if(!x)return '';var p=String(x).split('-');return (+p[2])+' '+_MO[(+p[1])-1]+' '+p[0];}
    var topicRange=dMin?(_fd(dMin)+' – '+_fd(dMax)):RANGE;
    var parties=Object.keys(P).map(function(k){return P[k];}).sort(function(a,b){return b.total-a.total;});
    parties.forEach(function(pr){pr.sentiment=sentLabel(pr.pos,pr.neu,pr.neg);pr.topHandle=pr.top?('@'+pr.top[0]):'';pr.topText=pr.top?String(pr.top[8]||'').replace(/\s+/g,' ').slice(0,300):'';});
    var totals={cm:0,dcm:0,mp:0,mla:0,total:0,rt:0,likes:0};
    parties.forEach(function(p){['cm','dcm','mp','mla','total','rt','likes'].forEach(function(k){totals[k]+=p[k];});});
    var ins=[];if(parties.length){var tp=parties[0];ins.push(tp.party+' sabse zyada active — '+(tp.total).toLocaleString('en-IN')+' tweets, sentiment '+tp.sentiment+'.');
      var ng=parties.filter(function(p){return p.sentiment==='Negative';}).map(function(p){return p.party;});if(ng.length)ins.push('Negative narrative: '+ng.join(', ')+'.');
      var ps=parties.filter(function(p){return p.sentiment==='Positive';}).map(function(p){return p.party;});if(ps.length)ins.push('Positive/counter-messaging: '+ps.join(', ')+'.');
    }else ins.push('Is keyword par koi tweet nahi mila.');
    var now=new Date(),M=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return {topic:topic||kws[0],keywords:kws,trackingWindow:topicRange,dateRange:RANGE,handles:handles,hashtags:hashtags,reportDate:('0'+now.getDate()).slice(-2)+'-'+M[now.getMonth()],
      volume:{totalTweets:matched,retweets:rt,likes:lk,uniqueHandles:Object.keys(users).length,totalViews:vwT,sentiment:sentLabel(pos,neu,neg)},parties:parties,totals:totals,insights:ins};
  }
  function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  function IN(n){return (Number(n)||0).toLocaleString('en-IN');}
  function fmt(n){n=Number(n)||0;if(n>=1e7)return (n/1e7).toFixed(2)+' Cr';if(n>=1e5)return (n/1e5).toFixed(2)+' L';if(n>=1000)return (n/1000).toFixed(1)+'K';return n.toLocaleString('en-IN');}
  function sc(t){var m={Positive:'#2E7D32',Negative:'#C62828',Neutral:'#8a8a8a',Mixed:'#E65100'};return m[t]||'#8a8a8a';}
  var PCE='-webkit-print-color-adjust:exact;print-color-adjust:exact';
