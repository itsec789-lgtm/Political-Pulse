.csm-n{background:#FFF9C4;color:#6B5200}
.csm-p{background:#C8E6C9;color:#1B5E20}
.csm-neg{background:#FFCDD2;color:#B71C1C}
.cmx-chart-box{background:#fff;border:1.5px solid var(--border);border-radius:12px;padding:12px;margin-bottom:10px;box-shadow:0 1px 4px rgba(0,0,0,.05)}
.cb-title{font-family:'Rajdhani';font-size:11px;font-weight:700;color:#444;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}
.state-list-item{background:#fff;border:1.5px solid var(--border);border-radius:8px;padding:9px 11px;display:flex;align-items:center;gap:9px;cursor:pointer;transition:.15s;border-left:4px solid var(--sci);margin-bottom:5px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.state-list-item:hover{box-shadow:0 3px 12px rgba(0,0,0,.1);transform:translateX(3px)}
.sli-rank{font-family:'Rajdhani';font-size:16px;font-weight:700;color:var(--sci);min-width:22px}
.sli-name{font-weight:700;font-size:12px;flex:1}
.sli-views{font-family:'Rajdhani';font-size:13px;font-weight:700;color:var(--sci)}
.sli-party{font-size:9px;padding:2px 7px;border-radius:10px;font-weight:700}
.back-btn{background:#fff;border:1.5px solid #e0e0e0;border-radius:20px;padding:6px 18px;font-size:11px;cursor:pointer;color:#666;font-family:'DM Sans';transition:.15s;display:block;margin:8px auto}
