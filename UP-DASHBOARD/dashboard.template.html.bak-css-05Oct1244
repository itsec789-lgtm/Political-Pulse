function heatColor(t,mx){if(t<=0||mx<=0)return '#f4f0ea';var r=t/mx;var a=[253,232,208],b=[194,65,12];var c=a.map(function(v,i){return Math.round(v+(b[i]-v)*r);});return 'rgb('+c[0]+','+c[1]+','+c[2]+')';}
