@echo off
setlocal enabledelayedexpansion
title Dashboard Update - 07 Oct
color 0A

echo ======================================================================
echo   DASHBOARD UPDATE  --  05 se 07 October ke saare changes
echo ======================================================================
echo.

set "ROOT=%~dp0.."
set "SRC=%~dp0nayi-files"

if not exist "%ROOT%\DASHBOARD\server.js" (
  echo   [RUK JAO] Ye folder galat jagah par hai.
  echo.
  echo   "UPDATE_07-OCT" folder ko seedha apne
  echo   "Main Twitter Project" folder ke ANDAR rakho, phir ye dobara chalao.
  echo.
  echo   Abhi dhoonda yahan:  %ROOT%\DASHBOARD\server.js
  echo.
  pause
  exit /b 1
)

netstat -ano | findstr ":3000" | findstr LISTENING >nul 2>&1
if not errorlevel 1 (
  echo   [DHYAN DO] Port 3000 par server abhi chal raha hai.
  echo   Pehle uska black window band karo, phir ye dobara chalao.
  echo.
  pause
  exit /b 1
)

for /f "tokens=2 delims==" %%I in ('wmic os get localdatetime /value 2^>nul') do set "LDT=%%I"
set "STAMP=%LDT:~0,8%-%LDT:~8,6%"
set "BAK=%ROOT%\BACKUP-update-%STAMP%"

echo   Purani files ka backup yahan ja raha hai:
echo     %BAK%
echo.
mkdir "%BAK%\DASHBOARD"         2>nul
mkdir "%BAK%\DASHBOARD\data"    2>nul
mkdir "%BAK%\UP-DASHBOARD"      2>nul
mkdir "%BAK%\UP-DASHBOARD\data" 2>nul
mkdir "%BAK%\PunjabLens"        2>nul
mkdir "%BAK%\PunjabLens\public" 2>nul

set ERR=0

echo   --- DASHBOARD ---
call :one "DASHBOARD"    "server.js"
call :one "DASHBOARD"    "RUN_SERVER.bat"
call :one "DASHBOARD"    "PATCH_START_LIVE.bat"
call :one "DASHBOARD"    "dashboard.template.html"
call :one "DASHBOARD"    "x_scraper.js"
call :one "DASHBOARD"    "x_live.js"
call :one "DASHBOARD"    "tracker_section.js"
call :one "DASHBOARD"    "hreq_lib.js"
call :one "DASHBOARD"    "hreq_admin.js"
call :one "DASHBOARD"    "mapping_lib.js"
call :one "DASHBOARD"    "mapping_add.py"
call :one "DASHBOARD"    "rebuild_mapping.py"
call :one "DASHBOARD"    "push_mapping_to_mongo.py"
call :one "DASHBOARD"    "auto_update.py"
call :one "DASHBOARD"    "run_pipeline.py"
call :one "DASHBOARD"    "mapping_sync.py"
call :one "DASHBOARD"    "FIX_EXCEL_READER.bat"
call :one "DASHBOARD"    "RUN_MAPPING_UPDATE.bat"
call :one "DASHBOARD"    "update_dashboard.py"
call :one "DASHBOARD"    "sentiment.js"
call :one "DASHBOARD"    "sentiment_cli.py"
call :one "DASHBOARD"    "INSTALL_SENTIMENT.bat"
call :one "DASHBOARD"    "sentiment_tagger-3.0.0-py3-none-any.whl"

echo.
echo   --- UP-DASHBOARD ---
call :one "UP-DASHBOARD" "dashboard.template.html"
call :one "UP-DASHBOARD" "server.js"
call :one "UP-DASHBOARD" "update_dashboard.py"

echo.
echo   --- PunjabLens (Punjab dashboard) ---
REM Punjab har system par nahi hota. Na ho to chup-chaap chhod dete hain --
REM isse poora update fail nahi hona chahiye.
if not exist "%ROOT%\PunjabLens\server.js" (
  echo   [chhoda] PunjabLens is system par nahi hai -- Punjab ka hissa skip.
) else (
  call :one "PunjabLens" "server.js"
  call :one "PunjabLens" "public\index.html"
  call :one "PunjabLens" "public\ai-settings.js"
  call :one "PunjabLens" "public\wire.js"
  call :one "PunjabLens" "public\style.css"
  call :one "PunjabLens" "public\assistant.js"
  call :one "PunjabLens" "public\assistant-ai.js"
  call :one "PunjabLens" "public\punjab_dashboard_template.html"
)

echo.
echo   Saathi files (sirf tab daalenge jab wahan hain hi nahi):
call :ifmiss "DASHBOARD"    "sentiment_labels.json"
call :ifmiss "DASHBOARD"    "data\mapping_removed.json"
call :ifmiss "UP-DASHBOARD" "data\mapping_removed.json"
call :ifmiss "DASHBOARD"    "data\mapping_removed_candidates.json"
call :ifmiss "UP-DASHBOARD" "data\mapping_removed_candidates.json"

echo.
if %ERR% NEQ 0 (
  color 0C
  echo   ====================================================================
  echo   KUCH FILE COPY NAHI HUI -- upar dekho.
  echo   WAPAS_KARO.bat chala kar sab purana kar lo, phir batao.
  echo   ====================================================================
  echo.
  pause
  exit /b 1
)

REM ================== server.js ko jo files chahiye ==================
echo.
echo   Checking: server.js ^(Node^) ko jo files chahiye...
set MISS=0
for %%M in (ha_lib.js login_page.js mailer.js mongo_conf.js mongo_pool.js auth_lib.js report_lib.js x_live.js x_scraper.js tracker_section.js sentiment.js mapping_lib.js hreq_lib.js hreq_admin.js news_lib.js) do (
  if exist "%ROOT%\DASHBOARD\%%M" (echo     [ok]      %%M) else (echo     [MISSING] %%M & set MISS=1)
)

REM ================== pipeline ko jo files chahiye ==================
echo.
echo   Checking: pipeline ^(Python^) ko jo files chahiye...
for %%M in (mongo_conf.py src_chunks.py mongo_swap.py safe_write.py master_to_mongo.py phase2_push.py daily_report.py smart_import.py push_all_scopes.py update_dashboard.py sentiment_cli.py mapping_add.py rebuild_mapping.py) do (
  if exist "%ROOT%\DASHBOARD\%%M" (echo     [ok]      DASHBOARD\%%M) else (echo     [MISSING] DASHBOARD\%%M & set MISS=1)
)
for %%M in (mongo_conf.py src_chunks.py mongo_swap.py safe_write.py update_dashboard.py push_tweets.py) do (
  if exist "%ROOT%\UP-DASHBOARD\%%M" (echo     [ok]      UP-DASHBOARD\%%M) else (echo     [MISSING] UP-DASHBOARD\%%M & set MISS=1)
)

if !MISS! NEQ 0 (
  color 0C
  echo.
  echo   ====================================================================
  echo   Upar [MISSING] wali file is system par hai hi nahi.
  echo   Us file ke bina server ya pipeline chalega nahi.
  echo   Wo file doosre system ke usi folder se yahan copy kar do.
  echo   ====================================================================
  echo.
)

echo.
echo ======================================================================
echo   HO GAYA
echo ======================================================================
echo.
echo   AB YE KARO -- ISI KRAM ME:
echo.
echo     1^) DASHBOARD\RUN_MAPPING_UPDATE.bat   chalao
echo        ^(Mapping.xlsx se handle_master.json banta hai.
echo         Sirf Excel badalne se kuch nahi hota.^)
echo.
echo     2^) DASHBOARD\PATCH_START_LIVE.bat     chalao
echo        ^(START_LIVE.bat me auto-restart + memory flags lagata hai.
echo         Ek hi baar chahiye. Dobara chalao to khud keh dega
echo         "pehle se laga hua hai" -- nuksan nahi.^)
echo.
echo     3^) DASHBOARD\START_LIVE.bat            chalao
echo.
echo     4^) Browser me  Ctrl + F5  ^(teeno par: / , /up , /punjab/^)
echo.
echo     5^) Ek baar kholo:  http://localhost:3000/healthz
echo.
echo   Punjab me kya badla: "Political Lens Assistant" wali chat hata di gayi,
echo   aur pipeline me Punjab ab peeche nahi reh sakta ^(catch-up^).
echo.
echo   Sentiment pehli baar laga rahe ho to:  DASHBOARD\INSTALL_SENTIMENT.bat
echo.
echo   DHYAN DO -- login ek baar dobara karna padega.
echo   Password wahi purana chalega.
echo.
echo   Kuch galat lage to: WAPAS_KARO.bat
echo   Backup: %BAK%
echo.

> "%~dp0last-backup.txt" echo %BAK%

pause
exit /b 0

REM ---- file badlo (backup lekar) ----
:one
if not exist "%SRC%\%~1\%~2" (
  echo   [MISSING] %~1\%~2  -- package me hai hi nahi
  set ERR=1
  goto :eof
)
if exist "%ROOT%\%~1\%~2" (
  copy /y "%ROOT%\%~1\%~2" "%BAK%\%~1\%~2" >nul
  if errorlevel 1 (echo   [FAIL backup] %~1\%~2 & set ERR=1 & goto :eof)
)
copy /y "%SRC%\%~1\%~2" "%ROOT%\%~1\%~2" >nul
if errorlevel 1 (echo   [FAIL copy]   %~1\%~2 & set ERR=1) else (echo   [OK]          %~1\%~2)
goto :eof

REM ---- file SIRF tab daalo jab wahan hai hi nahi ----
REM mapping_removed.json aur sentiment_labels.json har system ki apni hain --
REM jo pehle se hai usse haath nahi lagate, warna aapki list mit jaayegi.
:ifmiss
if exist "%ROOT%\%~1\%~2" (
  echo   [pehle se hai]  %~1\%~2  -- chhua nahi
  goto :eof
)
if not exist "%SRC%\%~1\%~2" (
  echo   [MISSING] %~1\%~2  -- package me hai hi nahi
  set ERR=1
  goto :eof
)
copy /y "%SRC%\%~1\%~2" "%ROOT%\%~1\%~2" >nul
if errorlevel 1 (echo   [FAIL copy]     %~1\%~2 & set ERR=1) else (echo   [NAYI DAALI]    %~1\%~2)
goto :eof
