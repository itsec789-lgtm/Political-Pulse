app.get('/login', function (req, res) {
  if (!CFG.authEnabled) return res.redirect('/');     // login disabled
  if (currentUser(req)) return res.redirect('/');
  res.set('Content-Type', 'text/html; charset=utf-8').send(loginPage(''));
});

app.post('/login', async function (req, res) {
  const email = String(req.body.email || '').trim().toLowerCase();
  const pw = String(req.body.password || '');
  try {
    const u = await (await db()).collection('users').findOne({ _id: email, active: true });
    if (!u || hashPw(pw, u.salt) !== u.hash) {
      return res.status(401).set('Content-Type', 'text/html; charset=utf-8')
        .send(loginPage('Wrong email or password.'));
    }
    const exp = Date.now() + 12 * 3600 * 1000;      // 12 hours
    res.set('Set-Cookie', 'pl_session=' + encodeURIComponent(sign(email + '|' + exp))
      + '; Path=/; HttpOnly; SameSite=Lax; Max-Age=' + (12 * 3600));
    try {
      await (await db()).collection('login_log')
        .insertOne({ email: email, at: new Date(), ip: req.ip });
    } catch (e) { }
    res.redirect('/');
  } catch (e) {
    res.status(500).set('Content-Type', 'text/html; charset=utf-8')
      .send(loginPage('Could not connect to MongoDB: ' + e.message));
  }
});

app.get('/logout', function (req, res) {
  res.set('Set-Cookie', 'pl_session=; Path=/; HttpOnly; Max-Age=0');
  res.redirect('/login');
});

/* Everything else requires a login. */
app.use(function (req, res, next) {
  if (!CFG.authEnabled) return next();
  if (req.path === '/login' || req.path === '/logout') return next();
  if (currentUser(req)) return next();
  if (req.path.startsWith('/api/')) return res.status(401).json({ error: 'login required' });
  res.redirect('/login');
});

/* --------------------------------------------------------------- payload --
 * The aggregates are small, the tweets are large. Joining them produces
 * exactly the shape the dashboard used to read from data.js - which is why
 * no chart code had to change. It is cached in memory; after a new build,
 * hit /refresh. */
let _cache = null;                 // the precomputed, no-date-range payload
const _rangeCache = new Map();    // "from|to" -> payload
let _lastBuildSeen = '';

function rangeQuery(from, to) {
  if (!from && !to) return {};
  const q = { d: {} };
  if (from) q.d.$gte = String(from);
  if (to) q.d.$lte = String(to) + '\uffff';   // include the whole of the "to" day
  return q;
}

/* The date-range payload - every tweet in the window is fetched and fully
   re-aggregated. Counting on a sample would give wrong numbers, so the
   whole window is read and the result is cached. */
async function buildRangePayload(from, to) {
  const key = (from || '') + '|' + (to || '');
  if (_rangeCache.has(key)) return _rangeCache.get(key);

  const d = await db();
  const t0 = Date.now();
  const rows = await d.collection('tweets')
    .find(rangeQuery(from, to), { projection: { _id: 0 } }).toArray();

  const base = await baseMeta();
  const days = rows.map(r => String(r.d || '').slice(0, 10)).filter(Boolean).sort();
  const out = aggregate(rows, Object.assign({}, base, {
    live: true, range: true, date_from: days[0] || from || '', date_to: days[days.length - 1] || to || '',
    requested_from: from || '', requested_to: to || '',
    source_label: CFG.targetDb + ' · ' + (from || 'start') + ' → ' + (to || 'aaj'),
    served: new Date().toISOString()
  }));

  const limit = Number(CFG.explorerLimit) || 25000;
  if (out.explorer.length > limit) {
    out.explorer = out.explorer.slice()
      .sort((a, b) => String(b.d || '').localeCompare(String(a.d || '')))
      .slice(0, limit);
  }
  out.meta.explorer_sample = out.explorer.length;
  console.log('  range ' + key + ': ' + rows.length + ' tweets aggregated in ' + (Date.now() - t0) + ' ms');

  /* Keep the cache small - every custom date adds an entry. */
  if (_rangeCache.size > 12) _rangeCache.delete(_rangeCache.keys().next().value);
  _rangeCache.set(key, out);
  return out;
}

async function baseMeta() {
  try {
    const d = await db();
    const docs = await d.collection('aggregates').find({ _id: 'meta' }).toArray();
    return (docs[0] && docs[0].data) || {};
  } catch (e) { return {}; }
}

/* Has a new build landed? Then clear the cache automatically - otherwise
   the dashboard keeps showing stale data and you are left wondering why
   the push had no effect. */
async function watchBuild() {
  try {
    const d = await db();
    const m = await d.collection('meta').findOne({ _id: 'lastBuild' });
    const v = m ? String(m.value) : '';
    if (v && _lastBuildSeen && v !== _lastBuildSeen) {
      console.log('  new build detected (' + v + ') - cache cleared');
      _cache = null; _rangeCache.clear();
    }
    if (v) _lastBuildSeen = v;
  } catch (e) { /* mongo is down - try again next time */ }
}

async function buildPayload() {
  const d = await db();
  const names = (await d.listCollections().toArray()).map(c => c.name);
  if (!names.includes('aggregates')) {
    throw new Error('No "aggregates" collection in ' + CFG.targetDb
      + ' - run python build_punjab_data.py --push first');
  }

  const docs = await d.collection('aggregates').find({}).toArray();
  const out = {};
  docs.forEach(function (x) { out[x._id] = x.data; });

  // Explorer = the latest N tweets. Insights, reports and the assistant
  // all run off it, so we take the most recent rather than a random
  // sample - that is the only way "what is happening now" reads right.
  const limit = Number(CFG.explorerLimit) || 25000;
  out.explorer = await d.collection('tweets')
    .find({}, { projection: { _id: 0 } })
    .sort({ d: -1 }).limit(limit).toArray();

  out.meta = Object.assign({ live: true }, out.meta || {});
  out.meta.explorer_sample = out.explorer.length;
  out.meta.served = new Date().toISOString();
  return out;
}

app.get('/api/data', async function (req, res) {
  res.set('Cache-Control', 'no-store');
  const from = String(req.query.from || '').trim();
  const to = String(req.query.to || '').trim();
  try {
    if (from || to) return res.json(await buildRangePayload(from, to));
    if (!_cache) _cache = await buildPayload();
    res.json(_cache);
  } catch (e) {
    console.error('  /api/data fail:', e.message);
    res.status(500).json({ error: e.message });
  }
});

app.get('/refresh', async function (req, res) {
  _cache = null; _rangeCache.clear();
  try {
    _cache = await buildPayload();
    res.json({ ok: true, tweets: _cache.kpis ? _cache.kpis.total_tweets : 0 });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

app.get('/api/status', async function (req, res) {
  res.set('Cache-Control', 'no-store');
  const out = { ok: false, db: CFG.targetDb, state: CFG.state,
                auth: !!CFG.authEnabled, user: currentUser(req) || '' };
  try {
    const d = await db();
    out.collections = (await d.listCollections().toArray()).map(c => c.name).sort();
    out.tweets = await d.collection('tweets').estimatedDocumentCount();
    const m = await d.collection('meta').findOne({ _id: 'lastBuild' });
    out.lastBuild = m ? m.value : '';
    const bm = await baseMeta();
    out.dateFrom = bm.date_from || '';
    out.dateTo = bm.date_to || '';
    out.ok = true;
  } catch (e) { out.error = e.message; }
  res.json(out);
});

/* Live search across the whole corpus, for finding tweets outside the
   explorer sample. The dashboard treats this as optional. */
app.get('/api/tweets', async function (req, res) {
  res.set('Cache-Control', 'no-store');
  try {
    const d = await db();
    const q = {};
    const term = String(req.query.q || '').trim();
    if (term) {
      const rx = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      q.$or = [{ tx: { $regex: rx, $options: 'i' } },
               { h: { $regex: rx, $options: 'i' } },
               { cn: { $regex: rx, $options: 'i' } }];
    }
    ['pt', 'sn', 'pc', 'dg', 'cat'].forEach(function (k) {
      if (req.query[k]) q[k] = String(req.query[k]);
    });
    if (req.query.h) {                        // ek handle ka poora record
      q.h = { $regex: '^' + String(req.query.h).replace(/^@/, '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '$', $options: 'i' };
    }
    if (req.query.from || req.query.to) {
      q.d = {};
      if (req.query.from) q.d.$gte = String(req.query.from);
      if (req.query.to) q.d.$lte = String(req.query.to) + '￿';
    }
    const sortKey = ({ eng: 'eng', likes: 'l', views: 'v', date: 'd' })[req.query.sort] || 'eng';
    const limit = Math.min(Number(req.query.limit) || 200, 2000);
    const rows = await d.collection('tweets')
      .find(q, { projection: { _id: 0 } })
      .sort({ [sortKey]: -1 }).limit(limit).toArray();
    res.json({ n: rows.length, rows: rows });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

/* ======================================================================
   AI  —  Gemini
   ----------------------------------------------------------------------
   The key never reaches the browser. The dashboard only calls /api/ask
   and /api/ai/narrative; the key stays here on the server in
   ai_config.json.

   RAW TWEETS are never sent to the model - only our own aggregate NUMBERS.
   That is what stops it inventing a fact, a name or a date; it can only
   read and write about the numbers it was given.
   ====================================================================== */
const AI_FILE = path.join(__dirname, 'ai_config.json');

/* Google keeps retiring models (gemini-2.0-flash is gone, gemini-2.5-pro
   is no longer offered to new users). So:
     - the default lives in one place, here
     - Settings fetches the model list LIVE from Google (/api/ai/models)
     - and if the chosen model has been retired, one automatic retry on
       the default keeps the dashboard working. */
const AI_DEFAULT_MODEL = 'gemini-3.5-flash';
const AI_DEAD = /no longer available|not found|NOT_FOUND|is not supported|has been (deprecated|shut ?down)/i;

function aiConfig() {
  try {
    const c = JSON.parse(fs.readFileSync(AI_FILE, 'utf8'));
    if (!c.model) c.model = AI_DEFAULT_MODEL;
    return c;
  }
  catch (e) { return { key: '', model: AI_DEFAULT_MODEL }; }
}
function aiSave(c) {
  fs.writeFileSync(AI_FILE, JSON.stringify(c, null, 2), { mode: 0o600 });
}

const AI_RULES =
  'STRICT RULES:\n'
  + '1. Use ONLY the numbers in the JSON provided. Never invent a fact, name, '
  + 'event, date or figure that is not in the JSON.\n'
  + '2. Tie every statement to a number (e.g. "AAP posted 4,231 tweets").\n'
  + '3. If the JSON does not contain the answer, say so plainly: '
  + '"That is not in this data."\n'
  + '4. If you are estimating, say "it looks like" or "roughly" - never state it as certain.\n'
  + '5. Write large numbers Indian style (1,23,456 or 2.4 Cr).\n'
  + '6. Keep the answer short and useful - no lectures.\n'
  + '7. Reply in clear, plain English.';

async function geminiOnce(model, key, system, user, maxTokens) {
  const url = 'https://generativelanguage.googleapis.com/v1beta/models/'
    + encodeURIComponent(model) + ':generateContent';

  const ctl = new AbortController();
  const timer = setTimeout(function () { ctl.abort(); }, 45000);
  try {
    const r = await fetch(url, {
      method: 'POST', signal: ctl.signal,
      headers: { 'Content-Type': 'application/json', 'x-goog-api-key': key },
      body: JSON.stringify({
        systemInstruction: { parts: [{ text: system }] },
        contents: [{ role: 'user', parts: [{ text: user }] }],
        generationConfig: { temperature: 0.25, maxOutputTokens: maxTokens || 900 }
      })
    });
    const j = await r.json().catch(function () { return {}; });
    if (!r.ok) {
      const msg = (j.error && j.error.message) || ('HTTP ' + r.status);
      throw new Error(msg);
    }
    const cand = (j.candidates || [])[0] || {};
    const parts = (cand.content && cand.content.parts) || [];
    const txt = parts.map(function (p) { return p.text || ''; }).join('').trim();
    if (!txt) throw new Error('The model returned an empty answer (possibly a safety filter).');
    return txt;
  } finally { clearTimeout(timer); }
}

async function gemini(system, user, maxTokens) {
  const cfg = aiConfig();
  if (!cfg.key) { const e = new Error('no-key'); e.code = 'no-key'; throw e; }
  if (typeof fetch !== 'function') throw new Error('This Node is too old - Node 18+ is required');

  const model = cfg.model || AI_DEFAULT_MODEL;
  try {
    return await geminiOnce(model, cfg.key, system, user, maxTokens);
  } catch (e) {
    /* Model retired? Try the default once and fix the config while we are
       here - otherwise the same error comes back on every request. */
    if (AI_DEAD.test(e.message) && model !== AI_DEFAULT_MODEL) {
      console.log('  AI: model "' + model + '" is retired -> switching to "' + AI_DEFAULT_MODEL + '"');
      const out = await geminiOnce(AI_DEFAULT_MODEL, cfg.key, system, user, maxTokens);
      try { aiSave({ key: cfg.key, model: AI_DEFAULT_MODEL }); } catch (x) { }
      return out;
    }
    throw e;
  }
}

app.get('/api/ai/status', function (req, res) {
  const c = aiConfig();
  res.set('Cache-Control', 'no-store');
  res.json({
    enabled: !!c.key,
    model: c.model || AI_DEFAULT_MODEL,
    keyTail: c.key ? ('••••' + String(c.key).slice(-4)) : ''
  });
});

app.post('/api/ai/key', express.json({ limit: '20kb' }), function (req, res) {
  const key = String((req.body && req.body.key) || '').trim();
  const model = String((req.body && req.body.model) || '').trim() || AI_DEFAULT_MODEL;
  try {
    if (!key) { aiSave({ key: '', model: model }); return res.json({ ok: true, enabled: false }); }
    aiSave({ key: key, model: model });
    res.json({ ok: true, enabled: true, keyTail: '••••' + key.slice(-4), model: model });
  } catch (e) { res.status(500).json({ ok: false, error: e.message }); }
});

/* The LIVE model list from Google - a hardcoded list goes stale every few
   months and starts returning "model no longer available". */
app.get('/api/ai/models', async function (req, res) {
  res.set('Cache-Control', 'no-store');
  const c = aiConfig();
  if (!c.key) return res.json({ models: [], reason: 'no-key' });
  try {
    const r = await fetch('https://generativelanguage.googleapis.com/v1beta/models?pageSize=200',
      { headers: { 'x-goog-api-key': c.key } });
    const j = await r.json();
    if (!r.ok) throw new Error((j.error && j.error.message) || ('HTTP ' + r.status));
    const list = (j.models || [])
      .filter(function (m) {
        return (m.supportedGenerationMethods || []).indexOf('generateContent') >= 0;
      })
      .map(function (m) { return String(m.name || '').replace(/^models\//, ''); })
      // text models only - image / tts / transcribe / embedding are no use here
      .filter(function (id) { return !/image|tts|transcribe|live|embedding|aqa|veo|imagen/i.test(id); })
      .sort();
    res.json({ models: list, current: c.model });
  } catch (e) {
    res.json({ models: [], error: e.message, current: c.model });
  }
});

/* An assistant question. The dashboard sends a digest of the filtered view. */
app.post('/api/ask', express.json({ limit: '256kb' }), async function (req, res) {
  const q = String((req.body && req.body.q) || '').slice(0, 800);
  const stats = (req.body && req.body.stats) || {};
  if (!q.trim()) return res.status(400).json({ error: 'the question is empty' });

  const system = 'You are the analyst behind the "Political Lens" dashboard, which '
    + 'tracks Twitter/X activity by Punjab politicians. You will be given the '
    + 'dashboard\'s COMPUTED figures as JSON.\n\n' + AI_RULES
    + '\n8. Use a short bullet list wherever a list is natural.';

  const user = 'QUESTION: ' + q + '\n\nDASHBOARD FIGURES (JSON):\n' + JSON.stringify(stats);

  try {
    const answer = await gemini(system, user, 900);
    res.json({ answer: answer });
  } catch (e) {
    if (e.code === 'no-key') return res.status(409).json({ error: 'no-key' });
    console.error('  /api/ask fail:', e.message);
    res.status(502).json({ error: e.message });
  }
});

/* Analysis for a report - returned as bullet points. */
app.post('/api/ai/narrative', express.json({ limit: '256kb' }), async function (req, res) {
  const stats = (req.body && req.body.stats) || {};
  const kind = String((req.body && req.body.kind) || 'report');

  const system = 'You are a senior political social-media analyst. You will be given the '
    + 'COMPUTED figures (JSON) from Punjab Twitter data. Write 6-8 sharp, useful insights '
    + 'in clear English. One insight per line, each starting with "- ". End with two lines of '
    + 'practical recommendation: which narrative to push, when to post (based on peak hours), '
    + 'and which constituency or party needs attention. Keep the political advice objective - '
    + 'do not campaign for any party.\n\n' + AI_RULES;

  const user = 'REPORT TYPE: ' + kind + '\n\nFIGURES (JSON):\n' + JSON.stringify(stats);

  try {
    const txt = await gemini(system, user, 1100);
    const bullets = txt.split('\n')
      .map(function (l) { return l.replace(/^[\s\-\*•\d.]+/, '').trim(); })
      .filter(function (l) { return l.length > 15; })
      .slice(0, 10);
    res.json({ bullets: bullets });
  } catch (e) {
    if (e.code === 'no-key') return res.status(409).json({ error: 'no-key' });
    console.error('  /api/ai/narrative fail:', e.message);
    res.status(502).json({ error: e.message });
  }
});

/* Full-corpus search for the topic report - it must reach tweets outside
   the explorer sample, otherwise the report only ever covers the latest
   25,000. */
app.get('/api/topic', async function (req, res) {
  res.set('Cache-Control', 'no-store');
  const term = String(req.query.q || '').trim();
  if (!term) return res.json({ n: 0, rows: [] });
  try {
    const d = await db();
    const terms = term.split(/[,|]/).map(function (t) { return t.trim(); }).filter(Boolean);
    const ors = terms.map(function (t) {
      return { tx: { $regex: t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), $options: 'i' } };
    });
    const q = ors.length ? { $or: ors } : {};
    if (req.query.from || req.query.to) {
      q.d = {};
      if (req.query.from) q.d.$gte = String(req.query.from);
      if (req.query.to) q.d.$lte = String(req.query.to) + '￿';
    }
    const cap = Math.min(Number(req.query.limit) || 60000, 120000);
    const rows = await d.collection('tweets').find(q, { projection: { _id: 0 } })
      .limit(cap).toArray();
    res.json({ n: rows.length, terms: terms, rows: rows });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

