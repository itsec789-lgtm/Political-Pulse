const PORT = Number(process.env.PORT) || Number(CFG.port) || 3000;

(async function boot() {
  console.log('\n  Political Lens — Punjab');
  console.log('  mongo : ' + CFG.mongoUrl);
  console.log('  db    : ' + CFG.targetDb);
  try {
    if (CFG.authEnabled) await ensureAdmin();
    else console.log('  login : DISABLED (config.json -> authEnabled)');
    const st = await db();
    const n = await st.collection('tweets').estimatedDocumentCount();
    console.log('  tweets: ' + n.toLocaleString('en-IN'));
    if (!n) console.log('  !! 0 tweets - run: python build_punjab_data.py --push');
  } catch (e) {
    console.log('  !! Could not connect to MongoDB: ' + e.message);
    console.log('     Open Compass -> mongodb://localhost:27017 -> Connect.');
    console.log('     If that fails: Win+R -> services.msc -> "MongoDB Server" -> Start');
  }
  /* Check every 3 minutes whether a new build has landed */
  setInterval(watchBuild, 3 * 60 * 1000);
  watchBuild();

  /* Listening on 0.0.0.0 so the team can open it from their phones on the
     office wifi - binding to localhost only would let no other machine
     connect at all. */
  app.listen(PORT, '0.0.0.0', function () {
    console.log('\n  Ready');
    console.log('    on this laptop  :  http://localhost:' + PORT);
    lanUrls(PORT).forEach(function (u) {
      console.log('    phone / team    :  ' + u);
    });
    console.log('\n  (If it will not open on a phone, Node needs to be allowed through');
    console.log('   Windows Firewall - Windows asks the first time, tick "Private networks".)\n');
  });
})();
