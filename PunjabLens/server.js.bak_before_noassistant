/* ------------------------------------------------------------------ gzip --
 * The Punjab payload still runs to a few MB. Node's own zlib compresses it -
 * no npm package needed, and the difference is obvious on mobile data. */
app.use(function (req, res, next) {
  const ae = String(req.headers['accept-encoding'] || '');
  if (!/\bgzip\b/.test(ae)) return next();
  const _json = res.json.bind(res);
  res.json = function (obj) {
    let buf;
    try { buf = Buffer.from(JSON.stringify(obj)); }
    catch (e) { return _json(obj); }
    if (buf.length < 4096) { res.set('Content-Type', 'application/json'); return res.send(buf); }
    zlib.gzip(buf, function (err, out) {
      if (err) { res.set('Content-Type', 'application/json'); return res.send(buf); }
      res.set('Content-Type', 'application/json');
      res.set('Content-Encoding', 'gzip');
      res.send(out);
    });
    return res;
  };
  next();
});

/* ------------------------------------------------------------------ mongo -- */
let _client = null;
async function db(name) {
  if (!_client) {
    _client = new MongoClient(CFG.mongoUrl, MONGO_OPT);
    await _client.connect();
  }
  return _client.db(name || CFG.targetDb);
}

/* ------------------------------------------------------------------- auth --
 * Passwords are never stored in plain text: a random per-user salt + sha256.
 * The session is a signed cookie (HMAC) - no npm session package. */
const SECRET_FILE = path.join(__dirname, '.session_secret');
let SECRET;
try { SECRET = fs.readFileSync(SECRET_FILE, 'utf8').trim(); } catch (e) { SECRET = ''; }
if (!SECRET) {
  SECRET = crypto.randomBytes(32).toString('hex');
  try { fs.writeFileSync(SECRET_FILE, SECRET, { mode: 0o600 }); } catch (e) { }
}

function hashPw(pw, salt) {
  return crypto.createHash('sha256').update(salt + '::' + pw).digest('hex');
}
function sign(v) {
  return v + '.' + crypto.createHmac('sha256', SECRET).update(v).digest('hex').slice(0, 32);
}
function unsign(s) {
  if (!s) return null;
  const i = s.lastIndexOf('.');
  if (i < 0) return null;
  const v = s.slice(0, i);
  return sign(v) === s ? v : null;
}
function cookies(req) {
  const out = {};
  String(req.headers.cookie || '').split(';').forEach(function (p) {
    const i = p.indexOf('=');
    if (i > 0) out[p.slice(0, i).trim()] = decodeURIComponent(p.slice(i + 1).trim());
  });
  return out;
}
function currentUser(req) {
  const raw = unsign(cookies(req).pl_session);
  if (!raw) return null;
  const parts = raw.split('|');           // email|expiryMs
  if (parts.length !== 2) return null;
  if (Number(parts[1]) < Date.now()) return null;
  return parts[0];
}

