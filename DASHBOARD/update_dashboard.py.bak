# -*- coding: utf-8 -*-
"""
update_dashboard.py  —  Nayi CSV se dashboard ka data update karo.

Kya karta hai:
  1. Aapki CSV (tweet-level data) padhta hai.
  2. Har handle ke metrics + daily (per-din) data recompute karta hai.
  3. dashboard_data (UNI totals, level, party, state, sentiment, daily AGG, PHD)
     ko refresh karta hai — NUMBERS naye, par level/party classification aur
     curated structure PURANE dashboard_data se PRESERVE karke (taaki dashboard na toote).
  4. handles / mapping / phd / dashboard_data ki nayi JSON files banata hai
     (mongo-dashboard/data/ me) + optionally MongoDB me push karta hai.

Chalane ka tarika:
    python update_dashboard.py "C:\\path\\to\\new_data.csv"
    python update_dashboard.py "C:\\path\\to\\new_data.csv" --push   (MongoDB me bhi likhe)

Zaroorat:  pip install pandas pymongo
Column naam se match hote hain (order koi bhi ho).

⚠️  NOTE: Pehli baar chalane ke baad DASHBOARD zaroor check karo. Kuch match na ho
    to mujhe (Data Team) batao — main us hisse ko tune kar dunga.
"""
import sys, os, json, collections
import pandas as pd

HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(HERE, "data")
CUR_DD = os.path.join(DATA, "dashboard_data.json")     # current (template) — level/curation yahin se preserve
MONGO_URL = "mongodb://localhost:27017"
DB_NAME = "india_pulse"

LVL = {'LS_MP':'LS MP','RS_MP':'RS MP','MLA':'MLA','Mla':'MLA','MLC':'MLC',
       'Chief Minister':'Chief Minister','Deputy Chief Minister':'Dy CM'}

# CSV column names (jo chahiye)
C = {'handle':'Handle','date':'Tweet Date','text':'Tweet Text','likes':'Total Likes',
     'rts':'Total Retweets','views':'Total Views','sent':'Sentiment','state':'State',
     'desig':'Designation','name':'Candidate Name','party':'Party',
     'followers':'Followers','followings':'Followings','pc':'PC Name','ac':'AC Name'}


def num(x):
    try: return float(str(x).replace(',', '')) if str(x).strip() not in ('', 'nan') else 0.0
    except Exception: return 0.0


def load_template():
    blobs = json.load(open(CUR_DD, encoding='utf-8'))
    return {b['key']: b['value'] for b in blobs}


def read_csv_agg(csv_path):
    """CSV -> per-handle stats + daily + meta + hashtags (column NAME se)."""
    acc = {}                 # handle -> {tw,lk,rt,vw,pos,neu,neg}
    meta = {}                # handle -> {name,party,levelCSV,state,followers,followings,pcName}
    daily = collections.defaultdict(lambda: [0, 0, 0, 0])   # (handle,date)->[t,v,k,r]
    dates = set()
    htag = collections.defaultdict(lambda: {'c':0,'lk':0,'vw':0,'pos':0,'neu':0,'neg':0})
    need = list(set(C.values()))
    for ch in pd.read_csv(csv_path, dtype=str, chunksize=200000, usecols=lambda c: c.strip() in need):
        ch = ch.rename(columns=lambda c: c.strip()).fillna('')
        for col in [C['likes'], C['rts'], C['views'], C['followers'], C['followings']]:
            ch[col] = pd.to_numeric(ch[col].str.replace(',', '', regex=False), errors='coerce').fillna(0)
        s = ch[C['sent']].str.strip().str.lower()
        ch['_pos'] = (s == 'positive').astype(int); ch['_neu'] = (s == 'neutral').astype(int); ch['_neg'] = (s == 'negative').astype(int)
        ch['_d'] = ch[C['date']].str[:10]
        # per-handle
        g = ch.groupby(C['handle']).agg(tw=(C['handle'], 'size'), lk=(C['likes'], 'sum'), rt=(C['rts'], 'sum'),
                                        vw=(C['views'], 'sum'), pos=('_pos', 'sum'), neu=('_neu', 'sum'), neg=('_neg', 'sum'))
        for h, r in g.iterrows():
            h = h.strip()
            if not h: continue
            a = acc.setdefault(h, {'tw':0,'lk':0,'rt':0,'vw':0,'pos':0,'neu':0,'neg':0})
            a['tw']+=int(r['tw']); a['lk']+=int(r['lk']); a['rt']+=int(r['rt']); a['vw']+=int(r['vw'])
            a['pos']+=int(r['pos']); a['neu']+=int(r['neu']); a['neg']+=int(r['neg'])
        # daily
        gd = ch.groupby([C['handle'], '_d']).agg(t=(C['handle'], 'size'), k=(C['likes'], 'sum'), r=(C['rts'], 'sum'), v=(C['views'], 'sum'))
        for (h, d), r in gd.iterrows():
            h = h.strip()
            if not h or len(d) != 10: continue
            dates.add(d); e = daily[(h, d)]; e[0]+=int(r['t']); e[1]+=int(r['v']); e[2]+=int(r['k']); e[3]+=int(r['r'])
        # meta (first non-empty)
        for r in ch.drop_duplicates(C['handle']).itertuples(index=False):
            row = dict(zip(ch.columns, r)); h = str(row[C['handle']]).strip()
            if h and h not in meta:
                meta[h] = {'name':row[C['name']], 'party':row[C['party']],
                           'levelCSV':LVL.get(str(row[C['desig']]).strip(), 'Others'),
                           'state':row[C['state']] or '—', 'followers':int(row[C['followers']]),
                           'followings':int(row[C['followings']]), 'pcName':row[C['pc']] or row[C['ac']] or ''}
        # hashtags
        import re
        for txt, p, n, u, g2 in zip(ch[C['text']], ch['_pos'], ch['_neu'], ch['_neg'], [1]*len(ch)):
            for tag in set(re.findall(r'#\w+', str(txt))):
                t = htag[tag.lower()]; t['c']+=1; t['pos']+=int(p); t['neu']+=int(n); t['neg']+=int(u)
    return acc, meta, daily, sorted(dates), htag


def build(csv_path):
    print("Reading CSV:", csv_path)
    acc, meta, daily, DATES, htag = read_csv_agg(csv_path)
    print(f"  handles={len(acc)}  dates={len(DATES)} ({DATES[0]}..{DATES[-1]})")
    tot_tw = sum(a['tw'] for a in acc.values())
    print(f"  total tweets={tot_tw:,}")

    tpl = load_template()
    # existing handle -> level (EXACT preserve); naye handles -> CSV level
    exist_level = {o['h']: o['level'] for o in tpl['UNI']['allHandles']}
    def level_of(h): return exist_level.get(h, meta.get(h, {}).get('levelCSV', 'Others'))

    # ---------- handles (master, _id=handle) ----------
    handles = []
    for h, a in acc.items():
        m = meta.get(h, {})
        handles.append({"_id": h, "name": m.get('name',''), "party": m.get('party',''),
                        "level": level_of(h), "state": m.get('state','—'), "pcName": m.get('pcName',''),
                        "followers": m.get('followers',0), "followings": m.get('followings',0),
                        "tweets": a['tw'], "views": a['vw'], "likes": a['lk'], "retweets": a['rt'],
                        "pos": a['pos'], "neu": a['neu'], "neg": a['neg']})

    # ---------- phd (per-handle daily arrays over DATES) ----------
    di = {d: i for i, d in enumerate(DATES)}
    phd = {}
    for (h, d), e in daily.items():
        o = phd.setdefault(h, {"t":[0]*len(DATES), "v":[0]*len(DATES), "k":[0]*len(DATES), "r":[0]*len(DATES)})
        i = di[d]; o['t'][i]=e[0]; o['v'][i]=e[1]; o['k'][i]=e[2]; o['r'][i]=e[3]
    phd_docs = [{"h": h, **v} for h, v in phd.items()]

    # ---------- mapping (level / party / state -> handles) ----------
    bl, bp, bs = collections.defaultdict(list), collections.defaultdict(list), collections.defaultdict(list)
    for h in acc:
        m = meta.get(h, {})
        bl[level_of(h)].append(h)
        bp[(m.get('party','') or 'Unknown').replace('.', '')].append(h)
        bs[(m.get('state','') or 'Unknown').replace('.', '')].append(h)
    mapping = [
        {"_id":"by_level","desc":"level -> handles","count":len(bl),"map":dict(bl)},
        {"_id":"by_party","desc":"party -> handles","count":len(bp),"map":dict(bp)},
        {"_id":"by_state","desc":"state -> handles","count":len(bs),"map":dict(bs)},
    ]

    # ---------- dashboard_data : NUMBERS refresh, structure preserve ----------
    dd = tpl  # start from current (keeps curated CM_DATA, HROLE, viral selections, exact level)
    # UNI.tot
    dd['UNI']['tot']['tw'] = tot_tw
    dd['UNI']['tot']['vw'] = sum(a['vw'] for a in acc.values())
    dd['UNI']['tot']['lk'] = sum(a['lk'] for a in acc.values())
    dd['UNI']['tot']['rt'] = sum(a['rt'] for a in acc.values())
    dd['UNI']['handles'] = len(acc)
    # UNI.level / party / state / sent (tweets)
    lv = collections.Counter(); pt = collections.Counter(); stt = collections.Counter(); sent = {'pos':0,'neu':0,'neg':0}
    for h, a in acc.items():
        m = meta.get(h, {})
        lv[level_of(h)] += a['tw']; pt[m.get('party','')] += a['tw']; stt[m.get('state','—')] += a['tw']
        for k in sent: sent[k] += a[k]
    dd['UNI']['level'] = dict(lv); dd['UNI']['party'] = dict(pt); dd['UNI']['states'] = dict(stt); dd['UNI']['sent'] = sent
    # UNI.allHandles (refresh numbers, keep order/meta shape)
    for o in dd['UNI']['allHandles']:
        a = acc.get(o['h'])
        if a: o.update({'tw':a['tw'],'vw':a['vw'],'lk':a['lk'],'rt':a['rt'],'pos':a['pos'],'neu':a['neu'],'neg':a['neg']})
    # STATE_DATA & PARTY_DATA numbers
    for row in dd['STATE_DATA']:
        s = row['state']; hs = [h for h in acc if meta.get(h,{}).get('state','—') == s]
        row.update(tweets=sum(acc[h]['tw'] for h in hs), views=sum(acc[h]['vw'] for h in hs),
                   likes=sum(acc[h]['lk'] for h in hs), pos=sum(acc[h]['pos'] for h in hs),
                   neu=sum(acc[h]['neu'] for h in hs), neg=sum(acc[h]['neg'] for h in hs))
    for party, row in dd['PARTY_DATA'].items():
        hs = [h for h in acc if meta.get(h,{}).get('party','') == party]
        row.update(tweets=sum(acc[h]['tw'] for h in hs), views=sum(acc[h]['vw'] for h in hs),
                   likes=sum(acc[h]['lk'] for h in hs), rt=sum(acc[h]['rt'] for h in hs),
                   pos=sum(acc[h]['pos'] for h in hs), neu=sum(acc[h]['neu'] for h in hs), neg=sum(acc[h]['neg'] for h in hs))
    # AGG.dates + PHD (dashboard_data me PHD alag collection hai — yahan sirf AGG rebuild)
    dd['AGG']['dates'] = DATES
    S = {}
    def add(key, e):
        o = S.setdefault(key, {"t":[0]*len(DATES),"v":[0]*len(DATES),"k":[0]*len(DATES),"r":[0]*len(DATES)})
        return o
    for (h, d), e in daily.items():
        i = di[d]; m = meta.get(h, {}); lvl_ = level_of(h); pty = m.get('party','')
        for key in [f"{lvl_}|{pty}", f"{lvl_}|ALL", f"ALL|{pty}", "ALL|ALL"]:
            o = add(key, e); o['t'][i]+=e[0]; o['v'][i]+=e[1]; o['k'][i]+=e[2]; o['r'][i]+=e[3]
    dd['AGG']['S'] = S

    dd_docs = [{"key": k, "value": v} for k, v in dd.items()]
    return handles, phd_docs, mapping, dd_docs, DATES, tot_tw


def write_files(handles, phd_docs, mapping, dd_docs):
    outs = {
        os.path.join(DATA, "dashboard_data.json"): dd_docs,
        os.path.join(DATA, "phd.json"): phd_docs,
        os.path.join(DATA, "handles.json"): handles,
        os.path.join(DATA, "mapping.json"): mapping,
    }
    for p, d in outs.items():
        p = os.path.abspath(p)
        json.dump(d, open(p, 'w', encoding='utf-8'), ensure_ascii=False)
        print("  wrote", p)


def push_mongo(handles, phd_docs, mapping, dd_docs):
    from pymongo import MongoClient
    cli = MongoClient(MONGO_URL); db = cli[DB_NAME]
    for coll, docs in [("handles", handles), ("phd", phd_docs), ("mapping", mapping), ("dashboard_data", dd_docs)]:
        db[coll].delete_many({}); db[coll].insert_many(docs)
        print(f"  MongoDB {coll}: {db[coll].count_documents({})} docs")
    cli.close()


if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit('Usage: python update_dashboard.py "path\\to\\data.csv" [--push]')
    csv_path = sys.argv[1]; push = '--push' in sys.argv
    handles, phd_docs, mapping, dd_docs, DATES, tot = build(csv_path)
    print("Writing files...")
    write_files(handles, phd_docs, mapping, dd_docs)
    if push:
        print("Pushing to MongoDB...")
        push_mongo(handles, phd_docs, mapping, dd_docs)
    print(f"\nDONE. tweets={tot:,}  handles={len(handles)}  dates={len(DATES)}")
    print("Ab dashboard: http://localhost:3000/refresh  phir reload.")
    print("(--push nahi diya to sirf JSON files bani — Compass se import kar lena.)")
