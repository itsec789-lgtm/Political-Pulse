@echo off
REM ============================================================
REM  Mapping.xlsx -> Mongo -> dashboard
REM  Double-click karo. Pehle sirf REPORT dikhega, phir puchhega.
REM  ('python' seedha mat chalana -- usme pandas/pymongo nahi hain)
REM ============================================================
cd /d "%~dp0"
title Mapping Update
set PY=C:\Users\hp\AppData\Local\Programs\Python\Python313\python.exe
if not exist "%PY%" set PY=python

echo.
echo  Python: %PY%
"%PY%" -c "import pandas, pymongo; print('  pandas + pymongo dono mil gaye')" 2>nul
if errorlevel 1 (
  echo.
  echo  !! Is Python me pandas ya pymongo nahi hai.
  echo     Ek baar ye chalao:
  echo        "%PY%" -m pip install pandas pymongo openpyxl
  echo.
  pause
  exit /b 1
)

echo.
echo ============================================================
echo   STEP 1 / 3   --  sirf REPORT (kuch nahi badlega)
echo ============================================================
"%PY%" push_mapping_to_mongo.py --check
if errorlevel 1 goto :fail

echo.
echo ============================================================
echo   Upar ki report dhyan se dekho.
echo ============================================================
set /p GO="  Aage badhein aur Mongo update karein? (Y/N): "
if /i not "%GO%"=="Y" (
  echo.
  echo   Rok diya. Kuch nahi badla.
  pause
  exit /b 0
)

echo.
echo ============================================================
echo   STEP 2 / 3   --  Mongo par mapping lagayi ja rahi hai
echo ============================================================
"%PY%" push_mapping_to_mongo.py
if errorlevel 1 goto :fail

echo.
echo ============================================================
echo   STEP 3 / 3   --  dashboard data dobara banaya ja raha hai
echo ============================================================
"%PY%" push_all_scopes.py MONGO
if errorlevel 1 goto :fail

echo.
echo ============================================================
echo   HO GAYA.
echo   Ab START_LIVE.bat band karke dobara chalao,
echo   phir browser me Ctrl+F5 dabao.
echo ============================================================
pause
exit /b 0

:fail
echo.
echo   !! Kuch galat hua -- upar ka error padho.
pause
exit /b 1
